---
import "../styles/global.css";
import { getCollection } from "astro:content";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import Nav from "../components/Nav.astro";
import Analytics from "../components/Analytics.astro";
import tierData from "../data/tier-table.json";

interface TierCell {
  strong?: string;
  text?: string;
  sub?: string;
  tone?: string;
}
interface TierColumn {
  key: string;
  label: string;
  hint?: string;
  kind?: string;
}
interface TierRow {
  model: { name: string; note?: string };
  cells: Record<string, TierCell>;
}
interface TierGroup {
  tier: { label: string; variant: string; sub?: string };
  rows: TierRow[];
}
interface TierTable {
  id: string;
  heading: string;
  lead?: string;
  tierColumnLabel: string;
  columns: TierColumn[];
  groups: TierGroup[];
}
interface TierNote {
  label?: string;
  text: string;
}

const data = tierData as unknown as {
  title: string;
  updated: string;
  tables: TierTable[];
  notes: TierNote[];
};

const relatedPostSpecs = [
  { slug: "test-theater", role: "評測方法 · 突變測試" },
  { slug: "model-routing", role: "派工策略 · 依判斷力分流" },
  { slug: "one-model-not-enough", role: "交叉審查 · 為什麼不只用一顆" },
  { slug: "vendor-benefit", role: "通道觀察 · 第三方額度與過濾" },
  { slug: "gpt-in-cc-performance", role: "跨模型觀察 · 規則執行性格" },
  { slug: "local-llm-hook-judge", role: "延遲取捨 · 免費通道與本地模型" },
] as const;

const allBlogPosts = await getCollection("blog");
const postsBySlug = new Map(allBlogPosts.map((post) => [post.id, post]));
const relatedPosts = relatedPostSpecs.map((spec) => {
  const post = postsBySlug.get(spec.slug);
  if (!post) {
    throw new Error(`Missing related blog post for /tier: ${spec.slug}`);
  }
  return {
    slug: spec.slug,
    role: spec.role,
    title: post.data.title,
    href: `/blog/${spec.slug}/`,
  };
});

const cellToneClass = (cell: TierCell | undefined, column: TierColumn): string => {
  if (column.kind === "note") return "cell-note";
  if (cell?.tone === "na") return "cell-metric tone-na";
  return [
    "cell-metric",
    cell?.tone === "good" && "tone-good",
    cell?.tone === "warn" && "tone-warn",
  ]
    .filter(Boolean)
    .join(" ");
};

const pageTitle = `${data.title} — gggodlin`;
const pageDescription = "我用私有專案的真實 PR 與突變測試考過的 AI 模型分級表。";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rssURL = new URL("rss.xml", Astro.site);
const tierJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalURL.toString(),
  inLanguage: "zh-Hant",
  dateModified: data.updated,
  author: {
    "@type": "Person",
    name: "Philip Lin",
    alternateName: "GGGODLIN",
    url: "https://gggodlin.com",
  },
};
const serializedTierJsonLd = JSON.stringify(tierJsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="zh-Hant" data-theme="anthropic-warm" data-mode="light" data-user-mode="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="gggodlin" />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="gggodlin" href={rssURL} />
    <script is:inline type="application/ld+json" set:html={serializedTierJsonLd} />
    <ThemeBoot />
  </head>
  <body>
    <main class="container">
      <header class="site-header">
        <div class="header-row">
          <h1><a href="/">GGGODLIN</a></h1>
          <Nav />
        </div>
      </header>

      <div class="tier-wide">
        <header class="page-head">
          <h2>{data.title}</h2>
          <span class="meta">更新於 <time datetime={data.updated}>{data.updated}</time></span>
        </header>

        <details class="reading-guide">
          <summary>
            <span>兩張表怎麼讀</span>
            <span class="guide-toggle" aria-hidden="true"></span>
          </summary>
          <dl class="guide-grid">
            <div>
              <dt>原始通過、重算通過與測試平均</dt>
              <dd>一題的隱藏驗收測試全過才算通過。以「原始過 3 題、重算 4/8 題」為例，8 題原本有 3 題全過，排除對應題目未寫清楚的要求的測試後，有 4 題全過。測試平均則是把各計分題目原始的隱藏測試通過率取平均。</dd>
            </div>
            <div>
              <dt>交付品質 A、B、C</dt>
              <dd>評審匿名看程式改動，品質和測試通過數分開計算。A 可直接採用，B 小修後可採用，C 需要返工。「A 5、B 3、C 0 題」表示 5 題評 A、3 題評 B、0 題評 C。未交件、作答作廢或無法還原程式改動時，評級可能少於 8 題。</dd>
            </div>
            <div>
              <dt>突變測試排名</dt>
              <dd>每題有一批刻意改壞的程式版本，請模型寫測試找出它們。小字的①②③依序是第 1、2、3 題，列抓到幾個版本及該題總數。括號是第 1 題的比例。每題各算名次，同分取所佔名次的平均，再把 3 題的名次相加，總和越小越前。</dd>
            </div>
            <div>
              <dt>抓真 bug</dt>
              <dd>拿掉專案曾做過的修正，再請模型寫測試。測試驗出使用者看得到的異常才得分。格內的前段、中段、後段只描述這批考卷的得分位置。重考紀錄只支持辨認前後兩群，群內順序會變。</dd>
            </div>
            <div>
              <dt>Sol 拆工驗收</dt>
              <dd>同一組 8 道改程式題，由 GPT-6.1 Sol 分配工作、檢查交件，表中模型負責改程式。Sol 直接教做法或發生其他嚴重違規時，該題不計分。服務中斷或拒答也可能沒有分數。</dd>
            </div>
            <div>
              <dt>用 Gemini 4 Argon 對照兩張表</dt>
              <dd>Gemini 4 Argon 在前沿表列 B 級，也放在非前沿表頂部供比較。兩處「自己做真實 PR」是同一筆成績，8 題原始過 5 題，重算後過 6 題。</dd>
            </div>
            <div>
              <dt>分級、顏色與推理設定</dt>
              <dd>S、A、B 和 T1～T4 是模型分組。品質欄的 A、B、C 是單題評級。色彩用來提示表現、注意事項或缺值，請以格內文字和數字為準。模型名稱下方也會註明推理設定、測試日期或其他測試條件。推理設定請按各家原名讀。</dd>
            </div>
          </dl>
        </details>

        {
          data.tables.map((table) => (
            <section class={`tier-section section-${table.id}`} id={table.id}>
              <div class="section-head">
                <h3>{table.heading}</h3>
                {table.lead && <p class="lead">{table.lead}</p>}
              </div>

              <div class="roster-scroll" role="region" aria-label={`${table.heading}捲動檢視`}>
                <div class={`roster roster--${table.id}`} role="table" aria-label={table.heading}>
                  <div class="roster-head" role="rowgroup">
                    <div class="roster-head-row" role="row">
                      <div class="rh-pillar" role="columnheader">{table.tierColumnLabel}</div>
                      <div class={`rh-cols cols--${table.id}`} role="none">
                        <div class="rh-col rh-model" role="columnheader">模型</div>
                        {table.columns.map((column) => (
                          <div
                            class={column.kind === "note" ? "rh-col rh-note" : `rh-col rh-${column.key}`}
                            role="columnheader"
                          >
                            <span class="rh-label">{column.label}</span>
                            {column.hint && <small class="rh-hint">{column.hint}</small>}
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>

                  <div class="roster-body" role="rowgroup">
                    {table.groups.map((group, groupIndex) => (
                      <div
                        class:list={[
                          "tier-band",
                          `band-${group.tier.variant}`,
                          { "band-lead": group.tier.variant === "s" || group.tier.variant === "t1" },
                          { "band-ref": group.tier.variant === "reference" },
                        ]}
                        style={`--band-index: ${groupIndex};`}
                        role="none"
                      >
                        <div class="tier-pillar" aria-hidden="true">
                          <span class="pillar-label">{group.tier.label}</span>
                          {group.tier.sub && <span class="pillar-sub">{group.tier.sub}</span>}
                        </div>

                        <div class="band-rows" role="none">
                          {group.rows.map((row) => {
                            const isArgonFrontier =
                              table.id === "frontier" && row.model.name === "Gemini 4 Argon";
                            const isArgonNonFrontier =
                              table.id === "non-frontier" && row.model.name === "Gemini 4 Argon";
                            const rowId = isArgonFrontier
                              ? "argon-frontier"
                              : isArgonNonFrontier
                                ? "argon-non-frontier"
                                : undefined;
                            const modelKey = `${table.id}:${row.model.name}`;
                            const compareMetrics = table.columns.map((column) => {
                              const cell = row.cells[column.key];
                              const val = [cell?.strong, cell?.text].filter(Boolean).join(" ") || "—";
                              return {
                                key: column.key,
                                label: column.label,
                                value: val,
                                sub: cell?.sub,
                              };
                            });
                            return (
                              <div
                                class={`model-row cols--${table.id}`}
                                role="row"
                                id={rowId}
                                data-model-key={modelKey}
                                data-table={table.id}
                                data-table-heading={table.heading}
                                data-tier-label={group.tier.label}
                                data-model-name={row.model.name}
                                data-model-note={row.model.note ?? ""}
                                data-compare-metrics={JSON.stringify(compareMetrics)}
                              >
                                <span class="sr-tier-cell" role="cell">
                                  {group.tier.label}
                                  {group.tier.sub ? `（${group.tier.sub}）` : ""}
                                </span>
                                <div class="cell-model" role="rowheader" data-label="模型">
                                  <span class="model-name">{row.model.name}</span>
                                  {row.model.note && (
                                    <span class="sub model-note">{row.model.note}</span>
                                  )}
                                  <div class="model-meta-actions">
                                    <button
                                      type="button"
                                      class="pin-btn"
                                      data-pin-model={modelKey}
                                      aria-pressed="false"
                                      aria-label={`釘選 ${row.model.name} 加入並排對照`}
                                    >
                                      + 對照
                                    </button>
                                    {isArgonFrontier && (
                                      <a class="bridge-link" href="#argon-non-frontier">
                                        看非前沿參考列（重算 6/8 題）↓
                                      </a>
                                    )}
                                    {isArgonNonFrontier && (
                                      <a class="bridge-link" href="#argon-frontier">
                                        回前沿表（原始過 5 題、重算 6/8 題）↑
                                      </a>
                                    )}
                                  </div>
                                </div>
                                {table.columns.map((column) => {
                                  const cell = row.cells[column.key];
                                  return (
                                    <div
                                      class={`${cellToneClass(cell, column)} col-${column.key}`}
                                      role="cell"
                                      data-label={column.label}
                                    >
                                      <span class="cell-val">
                                        {cell?.strong && <strong>{cell.strong}</strong>}
                                        {cell?.strong && cell?.text ? ` ${cell.text}` : cell?.text}
                                      </span>
                                      {cell?.sub && <span class="sub">{cell.sub}</span>}
                                    </div>
                                  );
                                })}
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </section>
          ))
        }

        <footer class="tier-notes">
          {
            data.notes.map((note) => (
              <p class={note.label ? "note-entry" : "note-entry note-footnote"}>
                {note.label && <strong>{note.label}</strong>}
                {note.label && "："}
                {note.text}
              </p>
            ))
          }
        </footer>

        <section class="related-reading" aria-label="相關方法論與實戰文章">
          <div class="related-head">
            <h3>這張表背後的方法論與實戰文章</h3>
            <p class="lead">以下為站內已發布的評測方法、模型性格與通道觀察，提供看表時的脈絡，並非同一批次考卷紀錄。</p>
          </div>
          <ul class="related-grid">
            {
              relatedPosts.map((post) => (
                <li>
                  <a class="related-card" href={post.href}>
                    <span class="related-role">{post.role}</span>
                    <span class="related-title">{post.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </main>
    <aside
      id="tier-compare-drawer"
      class="compare-drawer"
      aria-label="模型並排對照"
      hidden
    >
      <div class="compare-head">
        <div class="compare-head-title">
          <strong>並排對照</strong>
          <span id="compare-count" class="compare-count">0 / 3</span>
        </div>
        <div class="compare-head-actions">
          <button type="button" id="compare-toggle" class="compare-chip" aria-expanded="true">
            收合
          </button>
          <button type="button" id="compare-clear" class="compare-chip">清空</button>
        </div>
      </div>
      <div id="compare-body" class="compare-body"></div>
    </aside>
    <ThemeSwitcher />
    <Analytics />

    <script>
      import {
        MAX_PINNED_MODELS,
        buildComparisonRows,
        togglePinnedModel,
        type CompareModelRecord,
      } from "../data/tier-compare.ts";

      const rows = Array.from(document.querySelectorAll<HTMLElement>(".model-row"));
      const compareDrawer = document.getElementById("tier-compare-drawer") as HTMLElement | null;
      const compareCountEl = document.getElementById("compare-count");
      const compareBodyEl = document.getElementById("compare-body") as HTMLElement | null;
      const compareToggleBtn = document.getElementById("compare-toggle") as HTMLButtonElement | null;
      const compareClearBtn = document.getElementById("compare-clear") as HTMLButtonElement | null;
      const pinButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-pin-model]"));

      const compareCatalog = new Map<string, CompareModelRecord>();
      for (const el of rows) {
        const key = el.dataset.modelKey ?? "";
        if (!key) continue;
        let metrics: CompareModelRecord["metrics"] = [];
        try {
          metrics = JSON.parse(el.dataset.compareMetrics ?? "[]");
        } catch {
          metrics = [];
        }
        compareCatalog.set(key, {
          id: key,
          tableId: el.dataset.table ?? "",
          tableHeading: el.dataset.tableHeading ?? "",
          tierLabel: el.dataset.tierLabel ?? "",
          name: el.dataset.modelName ?? "",
          note: el.dataset.modelNote || undefined,
          metrics,
        });
      }

      let pinnedIds: string[] = [];
      let compareCollapsed = false;

      function renderCompareDrawer() {
        const atLimit = pinnedIds.length >= MAX_PINNED_MODELS;
        for (const btn of pinButtons) {
          const key = btn.dataset.pinModel ?? "";
          const pinned = pinnedIds.includes(key);
          btn.classList.toggle("is-pinned", pinned);
          btn.setAttribute("aria-pressed", String(pinned));
          btn.textContent = pinned ? "已釘選" : "+ 對照";
          btn.disabled = !pinned && atLimit;
        }

        if (!compareDrawer || !compareBodyEl) return;
        if (pinnedIds.length === 0) {
          compareDrawer.hidden = true;
          compareBodyEl.textContent = "";
          return;
        }

        compareDrawer.hidden = false;
        if (compareCountEl) {
          compareCountEl.textContent = `${pinnedIds.length} / ${MAX_PINNED_MODELS}`;
        }
        compareBodyEl.hidden = compareCollapsed;
        if (compareToggleBtn) {
          compareToggleBtn.textContent = compareCollapsed ? "展開" : "收合";
          compareToggleBtn.setAttribute("aria-expanded", String(!compareCollapsed));
        }

        const selected = pinnedIds
          .map((id) => compareCatalog.get(id))
          .filter((item): item is CompareModelRecord => Boolean(item));
        compareBodyEl.textContent = "";

        if (selected.length < 2) {
          const hint = document.createElement("p");
          hint.className = "compare-hint";
          hint.textContent = `已釘選 ${selected[0]?.name ?? ""}（${selected[0]?.tierLabel ?? ""}），再選 1～2 款模型即可並排對照。`;
          compareBodyEl.appendChild(hint);
          return;
        }

        const isCrossTable = new Set(selected.map((m) => m.tableId)).size > 1;
        const tableEl = document.createElement("table");
        tableEl.className = "compare-table";

        const thead = document.createElement("thead");
        const headRow = document.createElement("tr");
        const corner = document.createElement("th");
        corner.scope = "col";
        corner.textContent = "指標";
        headRow.appendChild(corner);

        for (const model of selected) {
          const th = document.createElement("th");
          th.scope = "col";
          const nameSpan = document.createElement("span");
          nameSpan.textContent = `${model.name}（${model.tierLabel}）`;
          th.appendChild(nameSpan);

          const removeBtn = document.createElement("button");
          removeBtn.type = "button";
          removeBtn.className = "compare-unpin";
          removeBtn.textContent = "×";
          removeBtn.setAttribute("aria-label", `移除 ${model.name}`);
          removeBtn.addEventListener("click", () => {
            pinnedIds = togglePinnedModel(pinnedIds, model.id);
            renderCompareDrawer();
          });
          th.appendChild(removeBtn);

          const sub = document.createElement("span");
          sub.className = "compare-sub";
          sub.textContent = model.note ? `${model.tableHeading} · ${model.note}` : model.tableHeading;
          th.appendChild(sub);
          headRow.appendChild(th);
        }
        thead.appendChild(headRow);
        tableEl.appendChild(thead);

        const tbody = document.createElement("tbody");
        for (const compRow of buildComparisonRows(selected)) {
          const tr = document.createElement("tr");
          const labelCell = document.createElement("th");
          labelCell.scope = "row";
          labelCell.textContent = compRow.label;
          if (isCrossTable && compRow.shared && compRow.key === "realPr") {
            const tag = document.createElement("span");
            tag.className = "compare-shared-tag";
            tag.textContent = "共用";
            labelCell.appendChild(tag);
          }
          tr.appendChild(labelCell);

          for (const val of compRow.values) {
            const td = document.createElement("td");
            td.textContent = val.value;
            if (val.sub) {
              const sub = document.createElement("span");
              sub.className = "compare-sub";
              sub.textContent = val.sub;
              td.appendChild(sub);
            }
            tr.appendChild(td);
          }
          tbody.appendChild(tr);
        }
        tableEl.appendChild(tbody);
        compareBodyEl.appendChild(tableEl);
      }

      for (const btn of pinButtons) {
        btn.addEventListener("click", () => {
          const key = btn.dataset.pinModel ?? "";
          pinnedIds = togglePinnedModel(pinnedIds, key);
          if (pinnedIds.length >= 2) compareCollapsed = false;
          renderCompareDrawer();
        });
      }

      compareToggleBtn?.addEventListener("click", () => {
        compareCollapsed = !compareCollapsed;
        renderCompareDrawer();
      });

      compareClearBtn?.addEventListener("click", () => {
        pinnedIds = [];
        compareCollapsed = false;
        renderCompareDrawer();
      });

      renderCompareDrawer();
    </script>

    <style>
      /* Site header untouched so nav position and width match all sibling pages */
      .site-header {
        margin-bottom: var(--section-gap);
      }
      .header-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: calc(var(--baseline) * 2);
        flex-wrap: wrap;
      }
      .header-row h1 {
        margin: 0;
      }
      .header-row h1 a {
        color: inherit;
        border: none;
      }
      .header-row h1 a:hover {
        color: var(--accent);
        border: none;
      }

      .tier-wide,
      .compare-drawer {
        --radius-band: 10px;
        --radius-inner: 6px;
        --ease-fluid: cubic-bezier(0.16, 1, 0.3, 1);
        --line-subtle: color-mix(in srgb, var(--text-primary) 9%, transparent);
        --line-medium: color-mix(in srgb, var(--text-primary) 16%, transparent);
        --band-surface: color-mix(in srgb, var(--bg-secondary) 55%, var(--bg-primary));
        --band-lead-surface: color-mix(in srgb, var(--accent) 7%, var(--bg-secondary));
        --row-hover: color-mix(in srgb, var(--text-primary) 4%, var(--bg-primary));
        /* Darker accent mixes keep small accent text & S/T1 pillars >= 4.5:1 across all 6 light themes */
        --accent-ink: color-mix(in srgb, var(--accent) 58%, var(--text-primary));
        --pillar-lead-bg: color-mix(in srgb, var(--accent) 70%, var(--text-primary));
        --pillar-lead-fg: var(--bg-primary);
        --good-ink: #3f6212;
        --warn-ink: #8a4312;
      }

      .tier-wide {
        position: relative;
        left: 50%;
        width: min(1320px, calc(100vw - 64px));
        transform: translateX(-50%);
      }

      :global([data-mode="dark"]) .tier-wide,
      :global([data-mode="dark"]) .compare-drawer {
        --line-subtle: color-mix(in srgb, var(--text-primary) 10%, transparent);
        --line-medium: color-mix(in srgb, var(--text-primary) 18%, transparent);
        --band-surface: color-mix(in srgb, var(--bg-secondary) 75%, var(--bg-primary));
        --band-lead-surface: color-mix(in srgb, var(--accent) 11%, var(--bg-secondary));
        --row-hover: color-mix(in srgb, var(--text-primary) 5%, var(--bg-secondary));
        --accent-ink: color-mix(in srgb, var(--accent) 72%, var(--text-primary));
        --pillar-lead-bg: var(--accent);
        --pillar-lead-fg: var(--bg-primary);
        --good-ink: #a2c76b;
        --warn-ink: #e7aa59;
      }

      /* Respect terminal-ollama's strictly achromatic accent contract */
      :global([data-theme="terminal-ollama"]) .tier-wide,
      :global([data-theme="terminal-ollama"]) .compare-drawer {
        --accent-ink: var(--text-primary);
        --good-ink: var(--text-primary);
        --warn-ink: var(--text-secondary);
      }

      /* Darken exaggerated-min light --text-secondary slightly inside /tier so 11-14px text reaches >= 4.5:1 */
      :global([data-theme="exaggerated-min"][data-mode="light"]) .tier-wide,
      :global([data-theme="exaggerated-min"][data-mode="light"]) .compare-drawer {
        --text-secondary: color-mix(in srgb, #78716c 88%, var(--text-primary));
      }

      .page-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--line-medium);
      }
      .page-head h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: 36px;
        line-height: 1.15;
        font-weight: 500;
        letter-spacing: -0.02em;
      }
      .meta {
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 18px;
        color: var(--text-secondary);
        font-variant-numeric: tabular-nums;
      }

      .reading-guide {
        margin-top: 18px;
        border: 1px solid var(--line-medium);
        border-radius: var(--radius-band);
        background: var(--band-surface);
        padding: 12px 18px;
      }
      .reading-guide summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        cursor: pointer;
        list-style: none;
        font-size: 14px;
        line-height: 22px;
        font-weight: 500;
        color: var(--text-primary);
      }
      .reading-guide summary::-webkit-details-marker {
        display: none;
      }
      .reading-guide summary:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
        border-radius: 4px;
      }
      .guide-toggle::after {
        content: "展開";
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-secondary);
        white-space: nowrap;
      }
      .reading-guide[open] .guide-toggle::after {
        content: "收合";
      }
      .guide-grid {
        margin: 14px 0 4px;
        padding-top: 14px;
        border-top: 1px solid var(--line-subtle);
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px 28px;
      }
      .guide-grid dt {
        font-size: 13px;
        line-height: 18px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 4px;
      }
      .guide-grid dd {
        margin: 0;
        font-size: 13px;
        line-height: 1.65;
        color: var(--text-secondary);
      }
      .bridge-link {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 11px;
        line-height: 16px;
        color: var(--accent-ink);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      .model-meta-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 10px;
        margin-top: 6px;
      }
      .pin-btn {
        font-family: var(--font-mono);
        font-size: 11px;
        line-height: 16px;
        padding: 2px 8px;
        border-radius: 999px;
        border: 1px solid var(--line-medium);
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        transition:
          background-color 150ms var(--ease-fluid),
          border-color 150ms var(--ease-fluid),
          color 150ms var(--ease-fluid);
      }
      .pin-btn:hover:not(:disabled) {
        border-color: var(--accent);
        color: var(--text-primary);
      }
      .pin-btn.is-pinned {
        background: var(--pillar-lead-bg);
        border-color: transparent;
        color: var(--pillar-lead-fg);
      }
      .pin-btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }
      .pin-btn:focus-visible,
      .compare-chip:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .compare-chip {
        font-family: var(--font-sans);
        font-size: 13px;
        line-height: 18px;
        padding: 5px 12px;
        border-radius: 999px;
        border: 1px solid var(--line-medium);
        background: var(--bg-primary);
        color: var(--text-primary);
        cursor: pointer;
      }
      .compare-chip:hover {
        border-color: var(--accent);
      }
      .compare-drawer {
        position: fixed;
        left: 20px;
        right: 104px;
        bottom: 16px;
        z-index: 40;
        max-width: 1120px;
        margin: 0 auto;
        border-radius: var(--radius-band);
        border: 1px solid var(--line-medium);
        background: var(--bg-primary);
        box-shadow: 0 12px 32px color-mix(in srgb, var(--text-primary) 14%, transparent);
        padding: 14px 18px;
      }
      .compare-drawer[hidden] {
        display: none;
      }
      .compare-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
      }
      .compare-head-title,
      .compare-head-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .compare-count {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-secondary);
      }
      .compare-body {
        margin-top: 12px;
        max-height: 46vh;
        overflow: auto;
      }
      .compare-body[hidden] {
        display: none;
      }
      :global(.compare-table) {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-sans);
        font-size: 13px;
        line-height: 1.5;
        font-variant-numeric: tabular-nums;
      }
      :global(.compare-table th),
      :global(.compare-table td) {
        border: none;
        border-top: 1px solid var(--line-subtle);
        background: transparent;
        padding: 8px 10px;
        font-family: inherit;
        font-size: inherit;
        text-transform: none;
        letter-spacing: normal;
        text-align: left;
        vertical-align: top;
      }
      :global(.compare-table thead th) {
        border-top: none;
        border-bottom: 1px solid var(--line-medium);
        color: var(--text-primary);
        font-weight: 600;
      }
      :global(.compare-table tbody th) {
        width: 140px;
        color: var(--text-secondary);
        font-weight: 500;
        white-space: nowrap;
      }
      :global(.compare-shared-tag) {
        display: inline-block;
        margin-left: 6px;
        font-family: var(--font-mono);
        font-size: 10px;
        padding: 1px 5px;
        border-radius: 4px;
        background: var(--band-lead-surface);
        color: var(--accent-ink);
      }
      :global(.compare-sub) {
        display: block;
        margin-top: 2px;
        font-size: 11px;
        color: var(--text-secondary);
      }
      :global(.compare-unpin) {
        margin-left: 6px;
        border: none;
        background: transparent;
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 12px;
        cursor: pointer;
        padding: 0 4px;
      }
      :global(.compare-unpin:hover) {
        color: var(--accent-ink);
      }
      :global(.compare-hint) {
        margin: 4px 0 0;
        font-size: 13px;
        color: var(--text-secondary);
      }
      .bridge-link:hover,
      .bridge-link:focus-visible {
        border-bottom-color: currentColor;
      }
      .model-row:target {
        scroll-margin-top: 24px;
        box-shadow: inset 0 0 0 2px var(--accent);
      }

      .tier-section {
        margin-top: 56px;
      }
      .section-frontier {
        margin-top: 32px;
      }
      .section-head {
        margin-bottom: 24px;
      }
      .section-head h3 {
        margin: 0 0 8px 0;
        font-family: var(--font-display);
        font-size: 24px;
        line-height: 1.25;
        font-weight: 500;
        letter-spacing: -0.015em;
      }
      .lead {
        margin: 0;
        font-size: 15px;
        line-height: 1.65;
        color: var(--text-secondary);
        max-width: 65ch;
      }

      .roster-scroll {
        width: 100%;
      }
      .roster {
        width: 100%;
        font-variant-numeric: tabular-nums;
      }

      /* Column Header Bar: exact horizontal geometry mirror of tier-band + band-rows */
      .roster-head {
        margin-bottom: 12px;
        padding: 0 1px;
      }
      .roster-head-row {
        display: grid;
        grid-template-columns: 84px minmax(0, 1fr);
        align-items: end;
      }
      .rh-pillar {
        padding: 8px 12px;
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 16px;
        font-weight: 500;
        color: var(--text-secondary);
        text-align: center;
      }
      .rh-cols {
        display: grid;
        gap: 12px;
        padding: 8px 16px;
        align-items: end;
      }
      .rh-col {
        min-width: 0;
        font-size: 13px;
        line-height: 18px;
        font-weight: 500;
        color: var(--text-primary);
      }
      .rh-label {
        display: block;
      }
      .rh-hint {
        display: block;
        margin-top: 2px;
        font-size: 12px;
        line-height: 16px;
        font-weight: 400;
        color: var(--text-secondary);
      }

      .cols--frontier {
        grid-template-columns: 184px 216px 206px 150px 136px minmax(220px, 1fr);
      }
      .cols--non-frontier {
        grid-template-columns: 176px 96px 96px 188px 118px 124px minmax(230px, 1fr);
      }

      /* Asymmetric Banded Roster Body */
      .roster-body {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .tier-band {
        display: grid;
        grid-template-columns: 84px minmax(0, 1fr);
        border-radius: var(--radius-band);
        border: 1px solid var(--line-medium);
        background: var(--band-surface);
        overflow: hidden;
        transition: border-color 180ms var(--ease-fluid);
      }
      @media (prefers-reduced-motion: no-preference) {
        .tier-band {
          animation: band-enter 420ms var(--ease-fluid) backwards;
          animation-delay: calc(min(var(--band-index, 0), 6) * 45ms);
        }
        @keyframes band-enter {
          from {
            opacity: 0;
            transform: translateY(10px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      }
      .tier-band:hover {
        border-color: color-mix(in srgb, var(--text-primary) 26%, transparent);
      }

      /* Top tier bands (S / T1): subtle warm accent presence, single accent locked */
      .tier-band.band-lead {
        background: var(--band-lead-surface);
        border-color: color-mix(in srgb, var(--accent) 42%, var(--border));
      }
      /* Reference divider band (交界) */
      .tier-band.band-ref {
        background: var(--bg-secondary);
        border-style: dashed;
        border-color: var(--line-medium);
      }

      /* Left Tier Pillar spanning the entire band */
      .tier-pillar {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        padding: 16px 8px;
        border-right: 1px solid var(--line-subtle);
        text-align: center;
      }
      .pillar-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        padding: 4px 10px;
        border-radius: var(--radius-inner);
        font-family: var(--font-display);
        font-size: 20px;
        line-height: 24px;
        font-weight: 500;
        color: var(--text-primary);
        white-space: nowrap;
      }
      .band-lead .tier-pillar {
        background: var(--pillar-lead-bg);
        border-right-color: transparent;
      }
      .band-lead .pillar-label {
        color: var(--pillar-lead-fg);
      }
      .band-a .tier-pillar,
      .band-t2 .tier-pillar {
        background: color-mix(in srgb, var(--text-primary) 7%, var(--bg-primary));
      }
      .band-b .tier-pillar,
      .band-t3 .tier-pillar {
        background: color-mix(in srgb, var(--text-primary) 3%, var(--bg-primary));
      }
      .band-b .pillar-label,
      .band-t3 .pillar-label {
        color: var(--text-secondary);
      }
      .band-t4 .tier-pillar,
      .band-ref .tier-pillar {
        background: transparent;
      }
      .band-t4 .pillar-label,
      .band-ref .pillar-label {
        font-family: var(--font-mono);
        font-size: 14px;
        color: var(--text-secondary);
      }
      .pillar-sub {
        font-family: var(--font-mono);
        font-size: 11px;
        line-height: 14px;
        color: var(--text-secondary);
        white-space: nowrap;
      }
      .band-lead .pillar-sub {
        color: var(--pillar-lead-fg);
      }

      /* Rows inside each band */
      .band-rows {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .model-row {
        position: relative;
        display: grid;
        gap: 12px;
        padding: 14px 16px;
        align-items: start;
        background: var(--bg-primary);
        transition: background-color 180ms var(--ease-fluid);
      }
      .band-lead .model-row {
        background: color-mix(in srgb, var(--accent) 3%, var(--bg-primary));
      }
      .band-ref .model-row {
        background: var(--bg-secondary);
      }
      .model-row + .model-row {
        border-top: 1px solid var(--line-subtle);
      }

      /* Keep Tier cell in ARIA row tree without occupying a desktop CSS Grid track */
      .sr-tier-cell {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .model-row::before {
        content: "";
        position: absolute;
        left: 0;
        top: 6px;
        bottom: 6px;
        width: 3px;
        border-radius: 0 3px 3px 0;
        background: var(--accent);
        opacity: 0;
        transform: scaleY(0.35);
        transition:
          transform 200ms var(--ease-fluid),
          opacity 200ms var(--ease-fluid);
        pointer-events: none;
      }
      .model-row:hover {
        background: var(--row-hover);
      }
      .model-row:hover::before {
        opacity: 1;
        transform: scaleY(1);
      }

      /* Cell typography */
      .cell-model,
      .cell-metric,
      .cell-note {
        min-width: 0;
      }
      .model-name {
        display: block;
        font-size: 14px;
        line-height: 20px;
        font-weight: 600;
        color: var(--text-primary);
      }
      .cell-val {
        display: block;
        font-size: 14px;
        line-height: 20px;
        color: var(--text-primary);
        white-space: nowrap;
      }
      .cell-val strong {
        font-weight: 600;
      }
      .sub {
        display: block;
        margin-top: 4px;
        font-size: 12px;
        line-height: 17px;
        color: var(--text-secondary);
        white-space: normal;
      }
      .cell-note .cell-val {
        font-size: 13px;
        line-height: 20px;
        color: var(--text-secondary);
        white-space: normal;
      }

      .tone-na .cell-val {
        color: var(--text-secondary);
      }
      .tone-good .cell-val {
        color: var(--good-ink);
        font-weight: 600;
      }
      .tone-warn .cell-val {
        color: var(--warn-ink);
        font-weight: 500;
      }

      .tier-notes {
        margin-top: 48px;
        padding: 24px 28px;
        border-radius: var(--radius-band);
        border: 1px solid var(--line-subtle);
        background: var(--band-surface);
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px 32px;
        font-size: 13px;
        line-height: 1.7;
        color: var(--text-secondary);
      }
      .note-entry {
        margin: 0;
      }
      .note-entry strong {
        font-weight: 600;
        color: var(--text-primary);
      }
      .note-footnote {
        grid-column: 1 / -1;
        padding-top: 12px;
        border-top: 1px solid var(--line-subtle);
        color: var(--text-secondary);
      }

      .related-reading {
        margin-top: 44px;
      }
      .related-head {
        margin-bottom: 18px;
      }
      .related-head h3 {
        margin: 0 0 6px;
        font-family: var(--font-display);
        font-size: 20px;
        line-height: 1.3;
        font-weight: 500;
      }
      .related-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 16px;
      }
      .related-card {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 14px 18px;
        border-radius: var(--radius-band);
        border: 1px solid var(--line-subtle);
        background: var(--bg-primary);
        text-decoration: none;
        transition:
          border-color 150ms var(--ease-fluid),
          background-color 150ms var(--ease-fluid);
      }
      .related-card:hover,
      .related-card:focus-visible {
        border-color: var(--accent);
        background: var(--band-surface);
        outline: none;
      }
      .related-card:focus-visible {
        box-shadow: 0 0 0 2px var(--accent);
      }
      .related-role {
        font-family: var(--font-mono);
        font-size: 11px;
        line-height: 16px;
        color: var(--text-secondary);
      }
      .related-title {
        font-size: 14px;
        line-height: 1.5;
        font-weight: 500;
        color: var(--text-primary);
      }

      @media (prefers-reduced-motion: reduce) {
        .tier-band {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
        .model-row,
        .model-row::before {
          transition: none !important;
        }
      }

      /* Tablet & narrow laptop: horizontal scroll before note column compresses */
      @media (max-width: 1320px) and (min-width: 769px) {
        .tier-wide {
          width: calc(100vw - 48px);
        }
        .roster-scroll {
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          padding-bottom: 6px;
        }
        .roster--non-frontier {
          min-width: 1180px;
        }
        .roster--frontier {
          min-width: 1170px;
        }
      }

      /* Mobile collapse: single-column tier bands */
      @media (max-width: 768px) {
        .tier-wide {
          position: static;
          left: auto;
          transform: none;
          width: 100%;
          padding-bottom: 64px;
        }
        .page-head h2 {
          font-size: 30px;
        }
        .tier-section {
          margin-top: 40px;
        }
        .roster-head {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
        }
        .tier-band {
          grid-template-columns: 1fr;
        }
        .tier-pillar {
          flex-direction: row;
          justify-content: flex-start;
          gap: 10px;
          padding: 10px 16px;
          border-right: none;
          border-bottom: 1px solid var(--line-subtle);
          text-align: left;
        }
        .pillar-label {
          min-width: auto;
          padding: 0;
          font-size: 16px;
          line-height: 20px;
        }
        .model-row,
        .cols--frontier,
        .cols--non-frontier {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 12px 16px;
          padding: 16px;
        }
        .cell-model {
          grid-column: 1 / -1;
          padding-bottom: 10px;
          border-bottom: 1px solid var(--line-subtle);
        }
        .model-name {
          font-size: 16px;
          line-height: 22px;
        }
        .cell-metric::before,
        .cell-note::before {
          content: attr(data-label);
          content: attr(data-label) / "";
          display: block;
          font-family: var(--font-mono);
          font-size: 11px;
          line-height: 16px;
          color: var(--text-secondary);
          margin-bottom: 2px;
        }
        .cell-val {
          white-space: normal;
        }
        .cols--non-frontier .col-analysis {
          grid-column: 1 / -1;
        }
        .cell-note {
          grid-column: 1 / -1;
          padding-top: 10px;
          border-top: 1px solid var(--line-subtle);
        }
        .guide-grid {
          grid-template-columns: 1fr;
          gap: 12px;
        }
        .tier-notes {
          grid-template-columns: 1fr;
          padding: 20px;
          gap: 12px;
        }
        .related-grid {
          grid-template-columns: 1fr;
        }
        .compare-drawer {
          left: 12px;
          right: 12px;
          bottom: 64px;
          padding: 12px 14px;
        }
      }

      @media print {
        .site-header,
        .compare-drawer,
        .pin-btn,
        :global(.ts-trigger),
        :global(.ts-panel) {
          display: none !important;
        }
        .tier-wide {
          position: static;
          left: auto;
          transform: none;
          width: 100%;
          padding-bottom: 0;
        }
        .roster-scroll {
          overflow: visible;
        }
        .roster--frontier,
        .roster--non-frontier {
          min-width: 0;
        }
        .tier-band {
          break-inside: avoid;
        }
      }
    </style>
  </body>
</html>
