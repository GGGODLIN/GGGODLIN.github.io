---
import "../styles/global.css";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import Nav from "../components/Nav.astro";
import Analytics from "../components/Analytics.astro";
import tierData from "../data/tier-table.json";

interface TierCell {
  strong?: string;
  text?: string;
  sub?: string;
  tone?: string;
}
interface TierColumn {
  key: string;
  label: string;
  hint?: string;
  kind?: string;
}
interface TierRow {
  model: { name: string; note?: string };
  cells: Record<string, TierCell>;
}
interface TierGroup {
  tier: { label: string; variant: string; sub?: string };
  rows: TierRow[];
}
interface TierTable {
  id: string;
  heading: string;
  lead?: string;
  tierColumnLabel: string;
  columns: TierColumn[];
  groups: TierGroup[];
}
interface TierNote {
  label?: string;
  text: string;
}

const data = tierData as unknown as {
  title: string;
  updated: string;
  tables: TierTable[];
  notes: TierNote[];
};

const cellToneClass = (cell: TierCell | undefined, column: TierColumn): string => {
  if (column.kind === "note") return "cell-note";
  if (cell?.tone === "na") return "cell-metric tone-na";
  return [
    "cell-metric",
    cell?.tone === "good" && "tone-good",
    cell?.tone === "warn" && "tone-warn",
  ]
    .filter(Boolean)
    .join(" ");
};

const pageTitle = `${data.title} — gggodlin`;
const pageDescription = "我用私有專案的真實 PR 與突變測試考過的 AI 模型分級表。";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rssURL = new URL("rss.xml", Astro.site);
const tierJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalURL.toString(),
  inLanguage: "zh-Hant",
  dateModified: data.updated,
  author: {
    "@type": "Person",
    name: "Philip Lin",
    alternateName: "GGGODLIN",
    url: "https://gggodlin.com",
  },
};
const serializedTierJsonLd = JSON.stringify(tierJsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="zh-Hant" data-theme="anthropic-warm" data-mode="light" data-user-mode="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="gggodlin" />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="gggodlin" href={rssURL} />
    <script is:inline type="application/ld+json" set:html={serializedTierJsonLd} />
    <ThemeBoot />
  </head>
  <body>
    <main class="container">
      <header class="site-header">
        <div class="header-row">
          <h1><a href="/">GGGODLIN</a></h1>
          <Nav />
        </div>
      </header>

      <div class="tier-wide">
        <header class="page-head">
          <h2>{data.title}</h2>
          <span class="meta">更新於 <time datetime={data.updated}>{data.updated}</time></span>
        </header>

        {
          data.tables.map((table) => (
            <section class={`tier-section section-${table.id}`} id={table.id}>
              <div class="section-head">
                <h3>{table.heading}</h3>
                {table.lead && <p class="lead">{table.lead}</p>}
              </div>

              <div class="roster-scroll" role="region" aria-label={`${table.heading}捲動檢視`}>
                <div class={`roster roster--${table.id}`} role="table" aria-label={table.heading}>
                  <div class="roster-head" role="rowgroup">
                    <div class="roster-head-row" role="row">
                      <div class="rh-pillar" role="columnheader">{table.tierColumnLabel}</div>
                      <div class={`rh-cols cols--${table.id}`} role="none">
                        <div class="rh-col rh-model" role="columnheader">模型</div>
                        {table.columns.map((column) => (
                          <div
                            class={column.kind === "note" ? "rh-col rh-note" : `rh-col rh-${column.key}`}
                            role="columnheader"
                          >
                            <span class="rh-label">{column.label}</span>
                            {column.hint && <small class="rh-hint">{column.hint}</small>}
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>

                  <div class="roster-body" role="rowgroup">
                    {table.groups.map((group, groupIndex) => (
                      <div
                        class:list={[
                          "tier-band",
                          `band-${group.tier.variant}`,
                          { "band-lead": group.tier.variant === "s" || group.tier.variant === "t1" },
                          { "band-ref": group.tier.variant === "reference" },
                        ]}
                        style={`--band-index: ${groupIndex};`}
                        role="none"
                      >
                        <div class="tier-pillar" aria-hidden="true">
                          <span class="pillar-label">{group.tier.label}</span>
                          {group.tier.sub && <span class="pillar-sub">{group.tier.sub}</span>}
                        </div>

                        <div class="band-rows" role="none">
                          {group.rows.map((row) => (
                            <div class={`model-row cols--${table.id}`} role="row">
                              <span class="sr-tier-cell" role="cell">
                                {group.tier.label}
                                {group.tier.sub ? `（${group.tier.sub}）` : ""}
                              </span>
                              <div class="cell-model" role="rowheader" data-label="模型">
                                <span class="model-name">{row.model.name}</span>
                                {row.model.note && (
                                  <span class="sub model-note">{row.model.note}</span>
                                )}
                              </div>
                              {table.columns.map((column) => {
                                const cell = row.cells[column.key];
                                return (
                                  <div
                                    class={`${cellToneClass(cell, column)} col-${column.key}`}
                                    role="cell"
                                    data-label={column.label}
                                  >
                                    <span class="cell-val">
                                      {cell?.strong && <strong>{cell.strong}</strong>}
                                      {cell?.strong && cell?.text ? ` ${cell.text}` : cell?.text}
                                    </span>
                                    {cell?.sub && <span class="sub">{cell.sub}</span>}
                                  </div>
                                );
                              })}
                            </div>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </section>
          ))
        }

        <footer class="tier-notes">
          {
            data.notes.map((note) => (
              <p class={note.label ? "note-entry" : "note-entry note-footnote"}>
                {note.label && <strong>{note.label}</strong>}
                {note.label && "："}
                {note.text}
              </p>
            ))
          }
        </footer>
      </div>
    </main>
    <ThemeSwitcher />
    <Analytics />

    <style>
      /* Site header untouched so nav position and width match all sibling pages */
      .site-header {
        margin-bottom: var(--section-gap);
      }
      .header-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: calc(var(--baseline) * 2);
        flex-wrap: wrap;
      }
      .header-row h1 {
        margin: 0;
      }
      .header-row h1 a {
        color: inherit;
        border: none;
      }
      .header-row h1 a:hover {
        color: var(--accent);
        border: none;
      }

      .tier-wide {
        --radius-band: 10px;
        --radius-inner: 6px;
        --ease-fluid: cubic-bezier(0.16, 1, 0.3, 1);
        --line-subtle: color-mix(in srgb, var(--text-primary) 9%, transparent);
        --line-medium: color-mix(in srgb, var(--text-primary) 16%, transparent);
        --band-surface: color-mix(in srgb, var(--bg-secondary) 55%, var(--bg-primary));
        --band-lead-surface: color-mix(in srgb, var(--accent) 7%, var(--bg-secondary));
        --row-hover: color-mix(in srgb, var(--text-primary) 4%, var(--bg-primary));
        /* Darker accent mix keeps S/T1 pillar contrast >= 4.5:1 across all 6 light themes */
        --pillar-lead-bg: color-mix(in srgb, var(--accent) 70%, var(--text-primary));
        --pillar-lead-fg: var(--bg-primary);
        --good-ink: #3f6212;
        --warn-ink: #8a4312;

        position: relative;
        left: 50%;
        width: min(1320px, calc(100vw - 64px));
        transform: translateX(-50%);
      }

      :global([data-mode="dark"]) .tier-wide {
        --line-subtle: color-mix(in srgb, var(--text-primary) 10%, transparent);
        --line-medium: color-mix(in srgb, var(--text-primary) 18%, transparent);
        --band-surface: color-mix(in srgb, var(--bg-secondary) 75%, var(--bg-primary));
        --band-lead-surface: color-mix(in srgb, var(--accent) 11%, var(--bg-secondary));
        --row-hover: color-mix(in srgb, var(--text-primary) 5%, var(--bg-secondary));
        --pillar-lead-bg: var(--accent);
        --pillar-lead-fg: var(--bg-primary);
        --good-ink: #a2c76b;
        --warn-ink: #e7aa59;
      }

      /* Respect terminal-ollama's strictly achromatic accent contract */
      :global([data-theme="terminal-ollama"]) .tier-wide {
        --good-ink: var(--text-primary);
        --warn-ink: var(--text-secondary);
      }

      .page-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--line-medium);
      }
      .page-head h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: 36px;
        line-height: 1.15;
        font-weight: 500;
        letter-spacing: -0.02em;
      }
      .meta {
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 18px;
        color: var(--text-secondary);
        font-variant-numeric: tabular-nums;
      }

      .tier-section {
        margin-top: 56px;
      }
      .section-frontier {
        margin-top: 32px;
      }
      .section-head {
        margin-bottom: 24px;
      }
      .section-head h3 {
        margin: 0 0 8px 0;
        font-family: var(--font-display);
        font-size: 24px;
        line-height: 1.25;
        font-weight: 500;
        letter-spacing: -0.015em;
      }
      .lead {
        margin: 0;
        font-size: 15px;
        line-height: 1.65;
        color: var(--text-secondary);
        max-width: 65ch;
      }

      .roster-scroll {
        width: 100%;
      }
      .roster {
        width: 100%;
        font-variant-numeric: tabular-nums;
      }

      /* Column Header Bar: exact horizontal geometry mirror of tier-band + band-rows */
      .roster-head {
        margin-bottom: 12px;
        padding: 0 1px;
      }
      .roster-head-row {
        display: grid;
        grid-template-columns: 84px minmax(0, 1fr);
        align-items: end;
      }
      .rh-pillar {
        padding: 8px 12px;
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 16px;
        font-weight: 500;
        color: var(--text-secondary);
        text-align: center;
      }
      .rh-cols {
        display: grid;
        gap: 12px;
        padding: 8px 16px;
        align-items: end;
      }
      .rh-col {
        min-width: 0;
        font-size: 13px;
        line-height: 18px;
        font-weight: 500;
        color: var(--text-primary);
      }
      .rh-label {
        display: block;
      }
      .rh-hint {
        display: block;
        margin-top: 2px;
        font-size: 12px;
        line-height: 16px;
        font-weight: 400;
        color: var(--text-secondary);
      }

      .cols--frontier {
        grid-template-columns: 184px 216px 206px 136px minmax(220px, 1fr);
      }
      .cols--non-frontier {
        grid-template-columns: 176px 96px 96px 188px 118px 124px minmax(230px, 1fr);
      }

      /* Asymmetric Banded Roster Body */
      .roster-body {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .tier-band {
        display: grid;
        grid-template-columns: 84px minmax(0, 1fr);
        border-radius: var(--radius-band);
        border: 1px solid var(--line-medium);
        background: var(--band-surface);
        overflow: hidden;
        transition: border-color 180ms var(--ease-fluid);
      }
      @media (prefers-reduced-motion: no-preference) {
        .tier-band {
          animation: band-enter 420ms var(--ease-fluid) backwards;
          animation-delay: calc(min(var(--band-index, 0), 6) * 45ms);
        }
        @keyframes band-enter {
          from {
            opacity: 0;
            transform: translateY(10px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      }
      .tier-band:hover {
        border-color: color-mix(in srgb, var(--text-primary) 26%, transparent);
      }

      /* Top tier bands (S / T1): subtle warm accent presence, single accent locked */
      .tier-band.band-lead {
        background: var(--band-lead-surface);
        border-color: color-mix(in srgb, var(--accent) 42%, var(--border));
      }
      /* Reference divider band (交界) */
      .tier-band.band-ref {
        background: var(--bg-secondary);
        border-style: dashed;
        border-color: var(--line-medium);
      }

      /* Left Tier Pillar spanning the entire band */
      .tier-pillar {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        padding: 16px 8px;
        border-right: 1px solid var(--line-subtle);
        text-align: center;
      }
      .pillar-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        padding: 4px 10px;
        border-radius: var(--radius-inner);
        font-family: var(--font-display);
        font-size: 20px;
        line-height: 24px;
        font-weight: 500;
        color: var(--text-primary);
        white-space: nowrap;
      }
      .band-lead .tier-pillar {
        background: var(--pillar-lead-bg);
        border-right-color: transparent;
      }
      .band-lead .pillar-label {
        color: var(--pillar-lead-fg);
      }
      .band-a .tier-pillar,
      .band-t2 .tier-pillar {
        background: color-mix(in srgb, var(--text-primary) 7%, var(--bg-primary));
      }
      .band-b .tier-pillar,
      .band-t3 .tier-pillar {
        background: color-mix(in srgb, var(--text-primary) 3%, var(--bg-primary));
      }
      .band-b .pillar-label,
      .band-t3 .pillar-label {
        color: var(--text-secondary);
      }
      .band-t4 .tier-pillar,
      .band-ref .tier-pillar {
        background: transparent;
      }
      .band-t4 .pillar-label,
      .band-ref .pillar-label {
        font-family: var(--font-mono);
        font-size: 14px;
        color: var(--text-secondary);
      }
      .pillar-sub {
        font-family: var(--font-mono);
        font-size: 11px;
        line-height: 14px;
        color: var(--text-secondary);
        white-space: nowrap;
      }
      .band-lead .pillar-sub {
        color: var(--pillar-lead-fg);
      }

      /* Rows inside each band */
      .band-rows {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .model-row {
        position: relative;
        display: grid;
        gap: 12px;
        padding: 14px 16px;
        align-items: start;
        background: var(--bg-primary);
        transition: background-color 180ms var(--ease-fluid);
      }
      .band-lead .model-row {
        background: color-mix(in srgb, var(--accent) 3%, var(--bg-primary));
      }
      .band-ref .model-row {
        background: var(--bg-secondary);
      }
      .model-row + .model-row {
        border-top: 1px solid var(--line-subtle);
      }

      /* Keep Tier cell in ARIA row tree without occupying a desktop CSS Grid track */
      .sr-tier-cell {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .model-row::before {
        content: "";
        position: absolute;
        left: 0;
        top: 6px;
        bottom: 6px;
        width: 3px;
        border-radius: 0 3px 3px 0;
        background: var(--accent);
        opacity: 0;
        transform: scaleY(0.35);
        transition:
          transform 200ms var(--ease-fluid),
          opacity 200ms var(--ease-fluid);
        pointer-events: none;
      }
      .model-row:hover {
        background: var(--row-hover);
      }
      .model-row:hover::before {
        opacity: 1;
        transform: scaleY(1);
      }

      /* Cell typography */
      .cell-model,
      .cell-metric,
      .cell-note {
        min-width: 0;
      }
      .model-name {
        display: block;
        font-size: 14px;
        line-height: 20px;
        font-weight: 600;
        color: var(--text-primary);
      }
      .cell-val {
        display: block;
        font-size: 14px;
        line-height: 20px;
        color: var(--text-primary);
        white-space: nowrap;
      }
      .cell-val strong {
        font-weight: 600;
      }
      .sub {
        display: block;
        margin-top: 4px;
        font-size: 12px;
        line-height: 17px;
        color: var(--text-secondary);
        white-space: normal;
      }
      .cell-note .cell-val {
        font-size: 13px;
        line-height: 20px;
        color: var(--text-secondary);
        white-space: normal;
      }

      .tone-na .cell-val {
        color: var(--text-secondary);
      }
      .tone-good .cell-val {
        color: var(--good-ink);
        font-weight: 600;
      }
      .tone-warn .cell-val {
        color: var(--warn-ink);
        font-weight: 500;
      }

      .tier-notes {
        margin-top: 48px;
        padding: 24px 28px;
        border-radius: var(--radius-band);
        border: 1px solid var(--line-subtle);
        background: var(--band-surface);
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px 32px;
        font-size: 13px;
        line-height: 1.7;
        color: var(--text-secondary);
      }
      .note-entry {
        margin: 0;
      }
      .note-entry strong {
        font-weight: 600;
        color: var(--text-primary);
      }
      .note-footnote {
        grid-column: 1 / -1;
        padding-top: 12px;
        border-top: 1px solid var(--line-subtle);
        color: var(--text-secondary);
      }

      @media (prefers-reduced-motion: reduce) {
        .tier-band {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
        .model-row,
        .model-row::before {
          transition: none !important;
        }
      }

      /* Tablet & narrow laptop: horizontal scroll before note column compresses */
      @media (max-width: 1320px) and (min-width: 769px) {
        .tier-wide {
          width: calc(100vw - 48px);
        }
        .roster-scroll {
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          padding-bottom: 6px;
        }
        .roster--non-frontier {
          min-width: 1180px;
        }
        .roster--frontier {
          min-width: 1020px;
        }
      }

      /* Mobile collapse: single-column tier bands */
      @media (max-width: 768px) {
        .tier-wide {
          position: static;
          left: auto;
          transform: none;
          width: 100%;
          padding-bottom: 64px;
        }
        .page-head h2 {
          font-size: 30px;
        }
        .tier-section {
          margin-top: 40px;
        }
        .roster-head {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
        }
        .tier-band {
          grid-template-columns: 1fr;
        }
        .tier-pillar {
          flex-direction: row;
          justify-content: flex-start;
          gap: 10px;
          padding: 10px 16px;
          border-right: none;
          border-bottom: 1px solid var(--line-subtle);
          text-align: left;
        }
        .pillar-label {
          min-width: auto;
          padding: 0;
          font-size: 16px;
          line-height: 20px;
        }
        .model-row,
        .cols--frontier,
        .cols--non-frontier {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 12px 16px;
          padding: 16px;
        }
        .cell-model {
          grid-column: 1 / -1;
          padding-bottom: 10px;
          border-bottom: 1px solid var(--line-subtle);
        }
        .model-name {
          font-size: 16px;
          line-height: 22px;
        }
        .cell-metric::before,
        .cell-note::before {
          content: attr(data-label);
          content: attr(data-label) / "";
          display: block;
          font-family: var(--font-mono);
          font-size: 11px;
          line-height: 16px;
          color: var(--text-secondary);
          margin-bottom: 2px;
        }
        .cell-val {
          white-space: normal;
        }
        .cols--non-frontier .col-analysis {
          grid-column: 1 / -1;
        }
        .cell-note {
          grid-column: 1 / -1;
          padding-top: 10px;
          border-top: 1px solid var(--line-subtle);
        }
        .tier-notes {
          grid-template-columns: 1fr;
          padding: 20px;
          gap: 12px;
        }
      }

      @media print {
        .site-header,
        :global(.theme-switcher) {
          display: none !important;
        }
        .tier-wide {
          position: static;
          left: auto;
          transform: none;
          width: 100%;
          padding-bottom: 0;
        }
        .roster-scroll {
          overflow: visible;
        }
        .roster--frontier,
        .roster--non-frontier {
          min-width: 0;
        }
        .tier-band {
          break-inside: avoid;
        }
      }
    </style>
  </body>
</html>
