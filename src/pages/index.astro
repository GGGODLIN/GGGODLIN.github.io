---
import { getCollection } from "astro:content";
import "../styles/global.css";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import Nav from "../components/Nav.astro";
import Analytics from "../components/Analytics.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const topicGroups = [
  {
    id: "workflow",
    label: "工作流",
    tags: [
      "workflow",
      "ai-workflow",
      "ai-agents",
      "subagent",
      "subagents",
      "resume",
      "deep-research",
    ],
  },
  {
    id: "models",
    label: "模型",
    tags: [
      "llm",
      "gpt",
      "model",
      "model-routing",
      "model-behavior",
      "llm-behavior",
      "vendor-swap",
      "local-llm",
      "multi-model",
      "quota",
    ],
  },
  {
    id: "tools",
    label: "工具",
    tags: [
      "tool-adoption",
      "tool-evaluation",
      "tooling",
      "mcp",
      "code-search",
      "skills",
      "skill",
      "fff",
      "token-optimization",
      "prompt-caching",
      "proxy",
    ],
  },
  {
    id: "memory",
    label: "記憶",
    tags: ["memory", "auto-memory", "knowledge-management", "vector-db"],
  },
  {
    id: "quality",
    label: "Review",
    tags: [
      "code-review",
      "testing",
      "mutation-testing",
      "ai-testing",
      "test-theater",
      "evaluation",
      "spec-review",
      "verify",
      "data-quality",
      "fact-check",
      "fabrication",
      "security",
      "supply-chain",
    ],
  },
  {
    id: "automation",
    label: "Hook",
    tags: ["hook", "hooks", "automation"],
  },
] as const;

function normalizeValue(value: string): string {
  return value.trim().toLowerCase();
}

function getTopicIds(tags: string[]): string[] {
  const normalizedTags = new Set(tags.map(normalizeValue));

  return topicGroups
    .filter((group) => group.tags.some((tag) => normalizedTags.has(tag)))
    .map((group) => group.id);
}

function formatDate(d: Date): string {
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
}

const siteDescription = "跟 Claude Code 一起踩坑，邊寫 code 邊寫心得。";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rssURL = new URL("rss.xml", Astro.site);
---

<!doctype html>
<html lang="zh-Hant" data-theme="anthropic-warm" data-mode="light" data-user-mode="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>gggodlin</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="gggodlin" />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="gggodlin" />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="gggodlin" href={rssURL} />
    <ThemeBoot />
  </head>
  <body>
    <main class="container">
      <header class="site-header" data-site-header>
        <div class="header-row">
          <h1><a href="/">GGGODLIN</a></h1>
          <div class="header-actions">
            <Nav />
            <button
              class="search-trigger"
              type="button"
              aria-label="開啟文章搜尋"
              aria-expanded="false"
              aria-controls="article-discovery"
              data-search-trigger
              hidden
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
            </button>
          </div>
        </div>
        <p class="bio">
          跟 Claude Code 一起踩坑，邊寫 code 邊寫心得。
        </p>
        <search
          class="article-discovery"
          id="article-discovery"
          data-article-discovery
          data-open="false"
          hidden
        >
          <div class="article-discovery-clip">
            <div class="article-discovery-inner">
              <div class="search-field-row">
                <label class="visually-hidden" for="article-search">搜尋文章</label>
                <input
                  class="search-input"
                  id="article-search"
                  name="q"
                  type="search"
                  placeholder="搜尋標題、摘要或 tag"
                  autocomplete="off"
                  aria-controls="post-list"
                />
                <p class="result-status" data-result-status aria-live="polite">
                  {posts.length} 篇
                </p>
              </div>
              <div class="topic-filters" role="group" aria-label="文章主題">
                <button
                  class="topic-filter"
                  type="button"
                  data-topic=""
                  aria-pressed="true"
                  aria-controls="post-list"
                >
                  全部
                </button>
                {
                  topicGroups.map((group) => (
                    <button
                      class="topic-filter"
                      type="button"
                      data-topic={group.id}
                      aria-pressed="false"
                      aria-controls="post-list"
                    >
                      {group.label}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </search>
      </header>
      <section class="post-list" id="post-list">
        <p class="empty-state" data-empty-state hidden>
          找不到符合條件的文章。
        </p>
        {
          posts.map((post, index) => {
            const searchText = normalizeValue(
              [post.data.title, post.data.description, ...post.data.tags].join(" "),
            );
            const topicIds = getTopicIds(post.data.tags);

            return (
              <article
                class:list={[
                  "post-item",
                  index < 8 && "post-item--reveal",
                ]}
                style={`--reveal-order: ${Math.min(index, 7)}`}
                data-post
                data-search={searchText}
                data-topics={topicIds.join(" ")}
              >
                <a href={`/blog/${post.id}/`}>
                  <h2>{post.data.title}</h2>
                </a>
                <p class="post-desc">{post.data.description}</p>
                <p class="post-meta">
                  {formatDate(post.data.pubDate)}
                  {post.data.tags.length > 0 && (
                    <>
                      <span aria-hidden="true"> · </span>
                      {post.data.tags.map((tag, index) => (
                        <>
                          {index > 0 && <span aria-hidden="true"> / </span>}
                          <button
                            class="tag-filter"
                            type="button"
                            data-search-tag={tag}
                            disabled
                          >
                            {tag}
                          </button>
                        </>
                      ))}
                    </>
                  )}
                </p>
              </article>
            );
          })
        }
      </section>
    </main>
    <ThemeSwitcher />
    <Analytics />
    <script>
      const discovery = document.querySelector<HTMLElement>(
        "[data-article-discovery]",
      );

      if (discovery) {
        const trigger = document.querySelector<HTMLButtonElement>(
          "[data-search-trigger]",
        );
        const siteHeader = document.querySelector<HTMLElement>(
          "[data-site-header]",
        );
        const input = discovery.querySelector<HTMLInputElement>(
          "#article-search",
        );
        const buttons = Array.from(
          discovery.querySelectorAll<HTMLButtonElement>("[data-topic]"),
        );
        const status = discovery.querySelector<HTMLElement>(
          "[data-result-status]",
        );
        const emptyState = document.querySelector<HTMLElement>(
          "[data-empty-state]",
        );
        const articles = Array.from(
          document.querySelectorAll<HTMLElement>("[data-post]"),
        );
        const tagButtons = Array.from(
          document.querySelectorAll<HTMLButtonElement>("[data-search-tag]"),
        );

        if (trigger && siteHeader && input && status && emptyState) {
          const reduceMotionQuery = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          );
          let activeTopic = "";
          let closeTimer: number | undefined;

          const updateResults = (): void => {
            const query = input.value.trim().toLowerCase();
            let visibleCount = 0;

            for (const article of articles) {
              const searchText = article.dataset.search ?? "";
              const topics = (article.dataset.topics ?? "").split(" ");
              const matchesQuery = query === "" || searchText.includes(query);
              const matchesTopic =
                activeTopic === "" || topics.includes(activeTopic);
              const isVisible = matchesQuery && matchesTopic;

              article.hidden = !isVisible;
              if (isVisible) visibleCount += 1;
            }

            const hasFilters = query !== "" || activeTopic !== "";
            status.textContent = hasFilters
              ? `${visibleCount} / ${articles.length} 篇`
              : `${articles.length} 篇`;
            emptyState.hidden = visibleCount !== 0;
          };

          const setActiveTopic = (topic: string): void => {
            activeTopic = topic;
            for (const button of buttons) {
              button.setAttribute(
                "aria-pressed",
                String((button.dataset.topic ?? "") === topic),
              );
            }
          };

          const finishClosing = (): void => {
            if (trigger.getAttribute("aria-expanded") === "false") {
              discovery.hidden = true;
            }
          };

          const setOpen = (open: boolean): void => {
            if (closeTimer !== undefined) {
              window.clearTimeout(closeTimer);
              closeTimer = undefined;
            }

            const shouldRestoreFocus =
              !open && discovery.contains(document.activeElement);
            trigger.setAttribute("aria-expanded", String(open));
            trigger.setAttribute(
              "aria-label",
              open ? "關閉文章搜尋" : "開啟文章搜尋",
            );
            siteHeader.classList.toggle("search-open", open);
            discovery.inert = !open;

            if (open) {
              discovery.hidden = false;
              discovery.dataset.open = "false";
              requestAnimationFrame(() => {
                if (trigger.getAttribute("aria-expanded") !== "true") return;
                discovery.dataset.open = "true";
                input.focus();
              });
              return;
            }

            discovery.dataset.open = "false";
            input.value = "";
            setActiveTopic("");
            updateResults();
            if (reduceMotionQuery.matches) {
              finishClosing();
            } else {
              closeTimer = window.setTimeout(() => {
                finishClosing();
                closeTimer = undefined;
              }, 240);
            }
            if (shouldRestoreFocus) trigger.focus();
          };

          input.addEventListener("input", updateResults);
          for (const button of buttons) {
            button.addEventListener("click", () => {
              setActiveTopic(button.dataset.topic ?? "");
              updateResults();
            });
          }
          for (const tagButton of tagButtons) {
            tagButton.addEventListener("click", () => {
              const tag = tagButton.dataset.searchTag ?? "";
              input.value = tag;
              setActiveTopic("");
              setOpen(true);
              updateResults();
              input.setSelectionRange(tag.length, tag.length);
            });
          }
          trigger.addEventListener("click", () => {
            setOpen(trigger.getAttribute("aria-expanded") !== "true");
          });
          document.addEventListener("keydown", (event) => {
            if (
              event.key === "Escape" &&
              trigger.getAttribute("aria-expanded") === "true"
            ) {
              setOpen(false);
            }
          });

          for (const tagButton of tagButtons) tagButton.disabled = false;
          trigger.hidden = false;
          updateResults();
        }
      }
    </script>
    <style>
      .header-actions {
        display: flex;
        align-items: center;
        gap: calc(var(--baseline) * 1);
      }
      .search-trigger[hidden],
      .article-discovery[hidden] {
        display: none;
      }
      .search-trigger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: calc(var(--baseline) * 4.5);
        height: calc(var(--baseline) * 4.5);
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        transition: color 150ms ease, transform 150ms ease;
      }
      .search-trigger:hover,
      .search-trigger[aria-expanded="true"] {
        color: var(--accent);
      }
      .search-trigger:active {
        transform: scale(0.9);
      }
      .search-trigger svg {
        transition: transform 180ms ease;
      }
      .search-trigger[aria-expanded="true"] svg {
        transform: rotate(-12deg) scale(0.94);
      }
      .search-trigger:focus-visible,
      .tag-filter:focus-visible {
        outline: 2px solid var(--text-primary);
        outline-offset: 2px;
      }
      .search-input:focus-visible,
      .topic-filter:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }
      .site-header.search-open {
        margin-bottom: calc(var(--baseline) * 4);
      }
      .article-discovery {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        transform: translateY(calc(var(--baseline) * -1));
        transition:
          grid-template-rows 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
          opacity 160ms ease,
          transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .article-discovery[data-open="true"] {
        grid-template-rows: 1fr;
        opacity: 1;
        transform: translateY(0);
      }
      .article-discovery-clip {
        min-height: 0;
        overflow: hidden;
      }
      .article-discovery-inner {
        margin-top: calc(var(--baseline) * 3);
        padding-top: calc(var(--baseline) * 2.5);
        border-top: 1px solid var(--border);
      }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .search-field-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: calc(var(--baseline) * 1.5);
      }
      .search-input {
        width: 100%;
        min-height: calc(var(--baseline) * 5);
        padding: calc(var(--baseline) * 0.75) calc(var(--baseline) * 1.25);
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--bg-secondary);
        color: var(--text-primary);
        font-family: inherit;
        font-size: 1rem;
        transition: border-color 150ms ease, background 150ms ease;
      }
      .search-input::placeholder {
        color: var(--text-secondary);
      }
      .topic-filters {
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--baseline) * 0.75);
        margin-top: calc(var(--baseline) * 1.25);
      }
      .topic-filter {
        min-height: calc(var(--baseline) * 4);
        padding: calc(var(--baseline) * 0.5) calc(var(--baseline) * 1.25);
        border: 1px solid var(--border);
        border-radius: 999px;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1;
        transition:
          color 140ms ease,
          background 140ms ease,
          border-color 140ms ease,
          transform 120ms ease;
      }
      .topic-filter:hover {
        border-color: var(--text-muted);
        color: var(--text-primary);
      }
      .topic-filter[aria-pressed="true"] {
        border-color: var(--text-primary);
        background: var(--text-primary);
        color: var(--bg-primary);
      }
      .topic-filter:active {
        transform: scale(0.96);
      }
      .result-status {
        margin: 0;
        color: var(--text-primary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        white-space: nowrap;
      }
      .empty-state {
        margin-bottom: calc(var(--baseline) * 4);
        color: var(--text-secondary);
      }
      .empty-state:not([hidden]) {
        animation: feedback-reveal 220ms ease-out both;
      }
      .post-item[hidden] {
        display: none;
      }
      .site-header {
        margin-bottom: var(--section-gap);
        animation: surface-reveal 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
        transition: margin-bottom 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .header-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: calc(var(--baseline) * 2);
        flex-wrap: wrap;
      }
      .header-row h1 {
        margin: 0;
      }
      .header-row h1 a {
        color: inherit;
        border: none;
      }
      .header-row h1 a:hover {
        color: var(--accent);
        border: none;
      }
      .bio {
        color: var(--text-secondary);
        font-size: var(--text-lg);
        margin-top: calc(var(--baseline) * 2);
      }
      .post-item {
        margin-bottom: calc(var(--baseline) * 5);
      }
      .post-item--reveal {
        animation: post-reveal 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
        animation-delay: calc(var(--reveal-order) * 45ms);
      }
      .post-item h2 {
        margin: 0 0 calc(var(--baseline) * 1);
        transform-origin: left center;
        transition: color 150ms ease, transform 180ms ease;
      }
      .post-item a {
        border: none;
      }
      .post-item a:hover h2 {
        color: var(--accent);
        transform: translateX(calc(var(--baseline) * 0.5));
      }
      .post-item a:active h2 {
        transform: translateX(calc(var(--baseline) * 0.25)) scale(0.995);
      }
      .post-desc {
        color: var(--text-secondary);
        margin-bottom: calc(var(--baseline) * 1);
      }
      .post-meta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .tag-filter {
        display: inline-block;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        font: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
        transition: color 140ms ease, transform 120ms ease;
      }
      .tag-filter:disabled {
        cursor: default;
      }
      .tag-filter:not(:disabled):hover {
        color: var(--accent);
      }
      .tag-filter:not(:disabled):active {
        transform: scale(0.94);
      }
      @keyframes surface-reveal {
        from {
          opacity: 0;
          transform: translateY(calc(var(--baseline) * -1));
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes post-reveal {
        from {
          opacity: 0;
          transform: translateY(calc(var(--baseline) * 1.25));
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes feedback-reveal {
        from {
          opacity: 0;
          transform: translateY(calc(var(--baseline) * 0.5));
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @media (max-width: 360px) {
        .header-row {
          position: relative;
        }
        .header-actions {
          width: 100%;
        }
        .search-trigger {
          position: absolute;
          top: 0;
          right: 0;
        }
      }
    </style>
  </body>
</html>
