---
import { getCollection } from "astro:content";
import "../styles/global.css";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(d: Date): string {
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
}
---

<!doctype html>
<html lang="zh-Hant" data-theme="anthropic-warm" data-mode="light" data-user-mode="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>gggodlin</title>
    <meta
      name="description"
      content="小小前端，月薪沒有十萬。跟 Claude Code 一起踩坑，邊寫 code 邊寫心得。"
    />
    <ThemeBoot />
  </head>
  <body>
    <main class="container">
      <header class="site-header">
        <h1>GGGODLIN</h1>
        <p class="bio">
          小小前端，月薪沒有十萬。跟 Claude Code 一起踩坑，邊寫 code 邊寫心得。
        </p>
      </header>
      <section class="post-list">
        {
          posts.map((post) => (
            <article class="post-item">
              <a href={`/blog/${post.id}/`}>
                <h2>{post.data.title}</h2>
              </a>
              <p class="post-desc">{post.data.description}</p>
              <p class="post-meta">
                {formatDate(post.data.pubDate)}
                {post.data.tags.length > 0
                  ? " · " + post.data.tags.join(" / ")
                  : ""}
              </p>
            </article>
          ))
        }
      </section>
    </main>
    <a
      class="gh-link"
      href="https://github.com/gggodlin"
      aria-label="GitHub"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 16 16" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 012-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
    <ThemeSwitcher />
    <style>
      .site-header {
        margin-bottom: var(--section-gap);
      }
      .bio {
        color: var(--text-secondary);
        font-size: var(--text-lg);
        margin-top: calc(var(--baseline) * 2);
      }
      .post-item {
        margin-bottom: calc(var(--baseline) * 5);
      }
      .post-item h2 {
        margin: 0 0 calc(var(--baseline) * 1);
      }
      .post-item a {
        border: none;
      }
      .post-item a:hover h2 {
        color: var(--accent);
      }
      .post-desc {
        color: var(--text-secondary);
        margin-bottom: calc(var(--baseline) * 1);
      }
      .post-meta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .gh-link {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 100;
        display: inline-flex;
        align-items: center;
        color: var(--text-secondary);
        border: none;
        transition: color 0.15s ease;
      }
      .gh-link:hover {
        color: var(--accent);
      }
    </style>
  </body>
</html>
