---
import { getCollection } from "astro:content";
import "../styles/global.css";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import Nav from "../components/Nav.astro";
import Analytics from "../components/Analytics.astro";
import { canonicalTagRegistry } from "../data/tag-registry";
import { getTopicIds, topicGroups } from "../data/topic-groups";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function normalizeValue(value: string): string {
  return value.trim().toLowerCase();
}

function formatDate(d: Date): string {
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
}

const siteDescription = "跟 Claude Code 一起踩坑，邊寫 code 邊寫心得。";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rssURL = new URL("rss.xml", Astro.site);
---

<!doctype html>
<html lang="zh-Hant" data-theme="anthropic-warm" data-mode="light" data-user-mode="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>gggodlin</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="gggodlin" />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="gggodlin" />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="gggodlin" href={rssURL} />
    <ThemeBoot />
    <script
      is:inline
      type="module"
      src="/vendor/jelly-ui/jelly.js"
    ></script>
  </head>
  <body>
    <main class="container">
      <header class="site-header" data-site-header>
        <div class="header-row">
          <h1 class="brand-lockup">
            <a href="/">GGGODLIN</a>
            <svg
              class="brand-mark"
              viewBox="0 0 180 18"
              preserveAspectRatio="none"
              aria-hidden="true"
              data-brand-mark
            >
              <path
                class="brand-line"
                data-brand-line
                d="M3 10 C42 16 91 14 177 7"
              ></path>
            </svg>
          </h1>
          <div class="header-actions">
            <Nav />
            <jelly-button
              class="search-trigger search-trigger--jelly"
              type="button"
              aria-label="開啟文章搜尋"
              aria-expanded="false"
              aria-controls="article-discovery"
              data-search-trigger
              hidden
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
            </jelly-button>
          </div>
        </div>
        <p class="bio">
          跟 Claude Code 一起踩坑，邊寫 code 邊寫心得。
        </p>
        <search
          class="article-discovery"
          id="article-discovery"
          data-article-discovery
          data-open="false"
          hidden
        >
          <div class="article-discovery-clip">
            <div class="article-discovery-inner">
              <div class="search-field-row">
                <label class="visually-hidden" for="article-search">搜尋文章</label>
                <input
                  class="search-input"
                  id="article-search"
                  name="q"
                  type="search"
                  placeholder="搜尋標題、摘要或 tag"
                  autocomplete="off"
                  aria-controls="post-list"
                />
                <p class="result-status" data-result-status aria-hidden="true">
                  {posts.length} 篇
                </p>
                <p
                  class="visually-hidden"
                  data-result-announcement
                  aria-live="polite"
                >
                  {posts.length} 篇
                </p>
              </div>
              <div class="topic-filters" role="group" aria-label="文章主題">
                <jelly-button
                  class="topic-filter topic-filter--jelly"
                  type="button"
                  data-topic=""
                  aria-pressed="true"
                  aria-controls="post-list"
                >
                  全部
                </jelly-button>
                {
                  topicGroups.map((group) => (
                    <jelly-button
                      class="topic-filter topic-filter--jelly"
                      type="button"
                      data-topic={group.id}
                      aria-pressed="false"
                      aria-controls="post-list"
                    >
                      {group.label}
                    </jelly-button>
                  ))
                }
              </div>
            </div>
          </div>
        </search>
      </header>
      <section class="post-list" id="post-list">
        <p class="empty-state" data-empty-state hidden>
          找不到符合條件的文章。
        </p>
        {
          posts.map((post, index) => {
            const tagLabels = post.data.tags.map((tag) =>
              canonicalTagRegistry.getLabel(tag),
            );
            const searchText = normalizeValue(
              [post.data.title, post.data.description, ...tagLabels].join(" "),
            );
            const topicIds = getTopicIds(post.data.tags);

            return (
              <article
                class:list={[
                  "post-item",
                  index < 8 && "post-item--reveal",
                ]}
                style={`--reveal-order: ${Math.min(index, 7)}`}
                data-post
                data-post-id={post.id}
                data-search={searchText}
                data-topics={topicIds.join(" ")}
              >
                <a class="post-title-link" href={`/blog/${post.id}/`}>
                  <h2>{post.data.title}</h2>
                  <svg
                    class="post-title-mark"
                    viewBox="0 0 180 18"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <path
                      class="post-title-line"
                      d="M3 10 C42 16 91 14 177 7"
                    ></path>
                  </svg>
                </a>
                <p class="post-desc">{post.data.description}</p>
                <p class="post-meta">
                  {formatDate(post.data.pubDate)}
                  {post.data.tags.length > 0 && (
                    <>
                      <span aria-hidden="true"> · </span>
                      {post.data.tags.map((tag, index) => (
                        <>
                          {index > 0 && <span aria-hidden="true"> / </span>}
                          <button
                            class="tag-filter"
                            type="button"
                            data-tag={tag}
                            aria-pressed="false"
                            disabled
                          >
                            {canonicalTagRegistry.getLabel(tag)}
                          </button>
                        </>
                      ))}
                    </>
                  )}
                </p>
              </article>
            );
          })
        }
      </section>
    </main>
    <ThemeSwitcher />
    <Analytics />
    <script>
      import { animate, scrambleText } from "animejs";
      import {
        createArticleDiscoveryState,
        filterArticleDiscovery,
        hasArticleDiscoveryFilters,
        transitionArticleDiscovery,
        type ArticleDiscoveryItem,
      } from "../data/article-discovery";

      const reduceMotionQuery = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const brandMark = document.querySelector<SVGElement>("[data-brand-mark]");

      if (brandMark) {
        const brandLine = brandMark.querySelector<SVGPathElement>(
          "[data-brand-line]",
        );
        if (reduceMotionQuery.matches || !brandLine) {
          brandMark.classList.add("brand-mark--ready");
        } else {
          animate(brandLine, {
            scaleX: [0, 1],
            opacity: [0.35, 1],
            duration: 720,
            delay: 220,
            ease: "out(4)",
          });
          brandMark.classList.add("brand-mark--ready");
        }
      }

      const titleLinks = Array.from(
        document.querySelectorAll<HTMLElement>(".post-title-link"),
      );
      let titleLineFrame: number | undefined;

      const syncTitleMarks = (): void => {
        for (const link of titleLinks) {
          const title = link.querySelector<HTMLElement>("h2");
          const mark = link.querySelector<SVGElement>(".post-title-mark");
          if (!title || !mark) continue;

          const range = document.createRange();
          range.selectNodeContents(title);
          const rects = Array.from(range.getClientRects()).filter(
            (rect) => rect.width > 0,
          );
          const lastRect = rects[rects.length - 1];
          if (!lastRect) continue;

          const linkRect = link.getBoundingClientRect();
          mark.style.left = `${lastRect.left - linkRect.left}px`;
          mark.style.top = `${lastRect.bottom - linkRect.top - 2}px`;
          mark.style.width = `${lastRect.width}px`;
          mark.classList.add("post-title-mark--ready");
        }
      };

      const scheduleTitleMarkSync = (): void => {
        if (titleLineFrame !== undefined) {
          cancelAnimationFrame(titleLineFrame);
        }
        titleLineFrame = requestAnimationFrame(() => {
          syncTitleMarks();
          titleLineFrame = undefined;
        });
      };

      const fontSet = "fonts" in document ? document.fonts : undefined;
      if (fontSet) {
        void fontSet.ready.then(scheduleTitleMarkSync);
        fontSet.addEventListener("loadingdone", scheduleTitleMarkSync);
        fontSet.addEventListener("loadingerror", scheduleTitleMarkSync);
      } else {
        scheduleTitleMarkSync();
      }
      window.addEventListener("resize", scheduleTitleMarkSync);
      const syncJellyMode = (): void => {
        const mode = document.documentElement.getAttribute("data-mode");
        if (mode === "light" || mode === "dark") {
          document.documentElement.setAttribute("data-jelly-mode", mode);
        } else {
          document.documentElement.removeAttribute("data-jelly-mode");
        }
      };
      const syncThemeSensitiveMotion = (): void => {
        syncJellyMode();
        scheduleTitleMarkSync();
        window.dispatchEvent(new CustomEvent("jelly-theme-change"));
      };
      new MutationObserver(syncThemeSensitiveMotion).observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ["data-theme", "data-mode"],
        },
      );
      syncThemeSensitiveMotion();

      const downgradeJellyButtons = (): void => {
        if (window.customElements?.get("jelly-button")) return;

        for (const element of document.querySelectorAll<HTMLElement>(
          "jelly-button",
        )) {
          const button = document.createElement("button");
          for (const attribute of Array.from(element.attributes)) {
            button.setAttribute(attribute.name, attribute.value);
          }
          button.classList.remove(
            "search-trigger--jelly",
            "topic-filter--jelly",
          );
          button.append(...Array.from(element.childNodes));
          element.replaceWith(button);
        }
      };

      downgradeJellyButtons();

      const discovery = document.querySelector<HTMLElement>(
        "[data-article-discovery]",
      );

      if (discovery) {
        const trigger = document.querySelector<HTMLElement>(
          "[data-search-trigger]",
        );
        const siteHeader = document.querySelector<HTMLElement>(
          "[data-site-header]",
        );
        const input = discovery.querySelector<HTMLInputElement>(
          "#article-search",
        );
        const buttons = Array.from(
          discovery.querySelectorAll<HTMLElement>("[data-topic]"),
        );
        const status = discovery.querySelector<HTMLElement>(
          "[data-result-status]",
        );
        const announcement = discovery.querySelector<HTMLElement>(
          "[data-result-announcement]",
        );
        const emptyState = document.querySelector<HTMLElement>(
          "[data-empty-state]",
        );
        const articles = Array.from(
          document.querySelectorAll<HTMLElement>("[data-post]"),
        );
        const tagButtons = Array.from(
          document.querySelectorAll<HTMLButtonElement>("[data-tag]"),
        );

        if (
          trigger &&
          siteHeader &&
          input &&
          status &&
          announcement &&
          emptyState
        ) {
          let discoveryState = createArticleDiscoveryState();
          let closeTimer: number | undefined;
          let statusAnimation: ReturnType<typeof animate> | undefined;
          const discoveryItems = articles.map((article) => ({
            id: article.dataset.postId ?? "",
            searchText: article.dataset.search ?? "",
            topicIds: (article.dataset.topics ?? "").split(" ").filter(Boolean),
            tagIds: Array.from(
              article.querySelectorAll<HTMLElement>(".tag-filter[data-tag]"),
            ).map((button) => button.dataset.tag ?? ""),
          })) satisfies ArticleDiscoveryItem[];

          const setResultStatus = (
            text: string,
            withMotion: boolean,
          ): void => {
            announcement.textContent = text;
            statusAnimation?.cancel();

            if (!withMotion || reduceMotionQuery.matches) {
              status.textContent = text;
              return;
            }

            statusAnimation = animate(status, {
              innerHTML: scrambleText({
                text,
                chars: "AI0123456789░▒▓",
                revealRate: 58,
                settleDuration: 320,
              }),
            });
          };

          const syncFilterControls = (): void => {
            for (const button of buttons) {
              button.setAttribute(
                "aria-pressed",
                String(
                  (button.dataset.topic ?? "") === discoveryState.topicId,
                ),
              );
            }
            for (const button of tagButtons) {
              button.setAttribute(
                "aria-pressed",
                String((button.dataset.tag ?? "") === discoveryState.tagId),
              );
            }
          };

          const updateResults = (withMotion = false): void => {
            const visibleIds = new Set(
              filterArticleDiscovery(discoveryItems, discoveryState).map(
                (article) => article.id,
              ),
            );

            for (const article of articles) {
              article.hidden = !visibleIds.has(article.dataset.postId ?? "");
            }

            const visibleCount = visibleIds.size;
            const hasFilters = hasArticleDiscoveryFilters(discoveryState);
            const nextStatus = hasFilters
              ? `${visibleCount} / ${articles.length} 篇`
              : `${articles.length} 篇`;
            setResultStatus(nextStatus, withMotion);
            emptyState.hidden = visibleCount !== 0;
            scheduleTitleMarkSync();
          };

          const finishClosing = (): void => {
            if (trigger.getAttribute("aria-expanded") === "false") {
              discovery.hidden = true;
            }
          };

          const setOpen = (open: boolean, focusInput = true): void => {
            if (closeTimer !== undefined) {
              window.clearTimeout(closeTimer);
              closeTimer = undefined;
            }

            const shouldRestoreFocus =
              !open && discovery.contains(document.activeElement);
            const triggerLabel = open ? "關閉文章搜尋" : "開啟文章搜尋";
            trigger.setAttribute("aria-expanded", String(open));
            trigger.setAttribute("aria-label", triggerLabel);
            if (trigger.localName === "jelly-button") {
              trigger.setAttribute("label", triggerLabel);
            }
            siteHeader.classList.toggle("search-open", open);
            discovery.inert = !open;

            if (open) {
              discovery.hidden = false;
              discovery.dataset.open = "false";
              requestAnimationFrame(() => {
                if (trigger.getAttribute("aria-expanded") !== "true") return;
                discovery.dataset.open = "true";
                if (focusInput) input.focus();
              });
              return;
            }

            discovery.dataset.open = "false";
            discoveryState = transitionArticleDiscovery(discoveryState, {
              type: "close",
            });
            input.value = discoveryState.query;
            syncFilterControls();
            updateResults();
            if (reduceMotionQuery.matches) {
              finishClosing();
            } else {
              closeTimer = window.setTimeout(() => {
                finishClosing();
                closeTimer = undefined;
              }, 240);
            }
            if (shouldRestoreFocus) trigger.focus();
          };

          input.addEventListener("input", () => {
            discoveryState = transitionArticleDiscovery(discoveryState, {
              type: "search",
              query: input.value,
            });
            syncFilterControls();
            updateResults();
          });
          for (const button of buttons) {
            button.addEventListener("click", () => {
              const topicId = button.dataset.topic ?? "";
              discoveryState = transitionArticleDiscovery(
                discoveryState,
                topicId === ""
                  ? { type: "reset" }
                  : { type: "topic", topicId },
              );
              input.value = discoveryState.query;
              syncFilterControls();
              updateResults(true);
            });
          }
          for (const tagButton of tagButtons) {
            tagButton.addEventListener("click", () => {
              discoveryState = transitionArticleDiscovery(discoveryState, {
                type: "tag",
                tagId: tagButton.dataset.tag ?? "",
              });
              input.value = discoveryState.query;
              syncFilterControls();
              setOpen(true, false);
              updateResults(true);
              input.setSelectionRange(
                discoveryState.query.length,
                discoveryState.query.length,
              );
            });
          }
          trigger.addEventListener("click", () => {
            setOpen(trigger.getAttribute("aria-expanded") !== "true");
          });
          document.addEventListener("keydown", (event) => {
            if (
              event.key === "Escape" &&
              trigger.getAttribute("aria-expanded") === "true"
            ) {
              setOpen(false);
            }
          });

          for (const tagButton of tagButtons) tagButton.disabled = false;
          if (trigger.localName === "jelly-button") {
            trigger.setAttribute(
              "label",
              trigger.getAttribute("aria-label") ?? "開啟文章搜尋",
            );
            void customElements.whenDefined("jelly-button").then(() => {
              trigger.hidden = false;
            });
          } else {
            trigger.hidden = false;
          }
          syncFilterControls();
          updateResults();
        }
      }
    </script>
    <style>
      .header-actions {
        display: flex;
        align-items: center;
        gap: calc(var(--baseline) * 1);
      }
      .search-trigger[hidden],
      .article-discovery[hidden] {
        display: none;
      }
      .search-trigger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: calc(var(--baseline) * 4.5);
        height: calc(var(--baseline) * 4.5);
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        transition:
          color 150ms ease,
          background-color 150ms ease,
          transform 150ms ease;
      }
      .search-trigger--jelly {
        width: calc(var(--baseline) * 5);
        height: calc(var(--baseline) * 5);
        border-radius: 999px;
        --jelly-button-height: calc(var(--baseline) * 5);
        --jelly-button-min-width: calc(var(--baseline) * 5);
        --jelly-button-padding-inline: 0px;
        --jelly-button-radius: 999px;
        --jelly-button-font-size: 0px;
        --jelly-fill: transparent;
        --jelly-label: var(--text-secondary);
        --jelly-ring: var(--accent);
      }
      .search-trigger:hover,
      .search-trigger[aria-expanded="true"] {
        color: var(--accent);
      }
      .search-trigger--jelly:hover {
        background: var(--bg-secondary);
        --jelly-fill: var(--bg-secondary);
        --jelly-label: var(--accent);
      }
      .search-trigger--jelly[aria-expanded="true"] {
        background: var(--accent);
        --jelly-fill: var(--accent);
        --jelly-label: var(--bg-primary);
        color: var(--bg-primary);
      }
      .search-trigger:not(.search-trigger--jelly):active {
        transform: scale(0.9);
      }
      .search-trigger svg {
        transition: transform 180ms ease;
      }
      .search-trigger[aria-expanded="true"] svg {
        transform: rotate(-12deg) scale(0.94);
      }
      .search-trigger:focus-visible,
      .tag-filter:focus-visible {
        outline: 2px solid var(--text-primary);
        outline-offset: 2px;
      }
      .search-trigger--jelly:focus-visible {
        outline: none;
      }
      .search-input:focus-visible,
      .topic-filter:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }
      .topic-filter--jelly:focus-visible {
        outline: none;
      }
      .site-header.search-open {
        margin-bottom: calc(var(--baseline) * 4);
      }
      .article-discovery {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        transform: translateY(calc(var(--baseline) * -1));
        transition:
          grid-template-rows 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
          opacity 160ms ease,
          transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .article-discovery[data-open="true"] {
        grid-template-rows: 1fr;
        opacity: 1;
        transform: translateY(0);
      }
      .article-discovery-clip {
        min-height: 0;
        overflow: hidden;
      }
      .article-discovery-inner {
        margin-top: calc(var(--baseline) * 3);
        padding-top: calc(var(--baseline) * 2.5);
        border-top: 1px solid var(--border);
      }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .search-field-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: calc(var(--baseline) * 1.5);
      }
      .search-input {
        width: 100%;
        min-height: calc(var(--baseline) * 5);
        padding: calc(var(--baseline) * 0.75) calc(var(--baseline) * 1.25);
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--bg-secondary);
        color: var(--text-primary);
        font-family: inherit;
        font-size: 1rem;
        transition: border-color 150ms ease, background 150ms ease;
      }
      .search-input::placeholder {
        color: var(--text-secondary);
      }
      .topic-filters {
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--baseline) * 0.75);
        margin-top: calc(var(--baseline) * 1.25);
      }
      .topic-filter {
        min-height: calc(var(--baseline) * 4);
        padding: calc(var(--baseline) * 0.5) calc(var(--baseline) * 1.25);
        border: 1px solid var(--border);
        border-radius: 999px;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        line-height: 1;
        transition:
          color 140ms ease,
          background 140ms ease,
          border-color 140ms ease,
          transform 120ms ease;
      }
      .topic-filter--jelly {
        min-height: 0;
        padding: 0;
        border: 0;
        background: transparent;
        --jelly-button-height: calc(var(--baseline) * 4.75);
        --jelly-button-min-width: 0px;
        --jelly-button-padding-inline: calc(var(--baseline) * 1.5);
        --jelly-button-font-size: 0.75rem;
        --jelly-button-radius: 999px;
        --jelly-font-display: var(--font-mono);
        --jelly-fill: var(--bg-secondary);
        --jelly-label: var(--text-secondary);
        --jelly-ring: var(--accent);
      }
      .topic-filter:hover {
        border-color: var(--text-muted);
        color: var(--text-primary);
      }
      .topic-filter[aria-pressed="true"] {
        border-color: var(--text-primary);
        background: var(--text-primary);
        color: var(--bg-primary);
      }
      .topic-filter:active {
        transform: scale(0.96);
      }
      .topic-filter--jelly:hover {
        border-color: transparent;
        --jelly-label: var(--text-primary);
      }
      .topic-filter--jelly[aria-pressed="true"] {
        border-color: transparent;
        background: transparent;
        color: var(--bg-primary);
        --jelly-fill: var(--text-primary);
        --jelly-label: var(--bg-primary);
      }
      .topic-filter--jelly:active {
        transform: none;
      }
      .result-status {
        margin: 0;
        color: var(--text-primary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        white-space: nowrap;
      }
      .empty-state {
        margin-bottom: calc(var(--baseline) * 4);
        color: var(--text-secondary);
      }
      .empty-state:not([hidden]) {
        animation: feedback-reveal 220ms ease-out both;
      }
      .post-item[hidden] {
        display: none;
      }
      .site-header {
        margin-bottom: var(--section-gap);
        animation: surface-reveal 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
        transition: margin-bottom 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .header-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: calc(var(--baseline) * 2);
        flex-wrap: wrap;
      }
      .header-row h1 {
        margin: 0;
      }
      .brand-lockup {
        position: relative;
        display: inline-block;
      }
      .brand-mark {
        position: absolute;
        top: calc(100% - 2px);
        left: -2%;
        width: 104%;
        height: 12px;
        overflow: visible;
        opacity: 0;
        pointer-events: none;
      }
      .brand-mark--ready {
        opacity: 1;
      }
      .brand-line {
        fill: none;
        stroke: var(--accent);
        stroke-width: 2.25;
        stroke-linecap: round;
        transform-box: fill-box;
        transform-origin: left center;
        vector-effect: non-scaling-stroke;
      }
      .header-row h1 a {
        color: inherit;
        border: none;
      }
      .header-row h1 a:hover {
        color: var(--accent);
        border: none;
      }
      .bio {
        color: var(--text-secondary);
        font-size: var(--text-lg);
        margin-top: calc(var(--baseline) * 2);
      }
      .post-item {
        margin-bottom: calc(var(--baseline) * 5);
      }
      .post-item--reveal {
        animation: post-reveal 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
        animation-delay: calc(var(--reveal-order) * 45ms);
      }
      .post-item h2 {
        margin: 0 0 calc(var(--baseline) * 1);
        transition: color 150ms ease;
      }
      .post-item a {
        border: none;
      }
      .post-title-link {
        position: relative;
        display: inline-block;
        max-width: 100%;
        transform-origin: left center;
        transition: transform 180ms ease;
      }
      .post-title-mark {
        position: absolute;
        top: 0;
        left: 0;
        display: none;
        width: 0;
        height: 12px;
        overflow: visible;
        opacity: 0;
        pointer-events: none;
        transition: opacity 120ms ease;
      }
      .post-title-mark--ready {
        display: block;
      }
      .post-title-line {
        fill: none;
        stroke: var(--accent);
        stroke-width: 2.25;
        stroke-linecap: round;
        transform: scaleX(0);
        transform-box: fill-box;
        transform-origin: left center;
        transition: transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1);
        vector-effect: non-scaling-stroke;
      }
      .post-title-link:hover,
      .post-title-link:focus-visible {
        transform: translateX(calc(var(--baseline) * 0.5));
      }
      .post-title-link:hover h2,
      .post-title-link:focus-visible h2 {
        color: var(--accent);
      }
      .post-title-link:hover .post-title-mark,
      .post-title-link:focus-visible .post-title-mark {
        opacity: 1;
      }
      .post-title-link:hover .post-title-line,
      .post-title-link:focus-visible .post-title-line {
        transform: scaleX(1);
      }
      .post-title-link:focus-visible {
        outline: 2px solid var(--text-primary);
        outline-offset: 4px;
      }
      .post-title-link:active {
        transform: translateX(calc(var(--baseline) * 0.25)) scale(0.995);
      }
      .post-desc {
        color: var(--text-secondary);
        margin-bottom: calc(var(--baseline) * 1);
      }
      .post-meta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .tag-filter {
        display: inline-block;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        font: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
        transition: color 140ms ease, transform 120ms ease;
      }
      .tag-filter:disabled {
        cursor: default;
      }
      .tag-filter:not(:disabled):hover,
      .tag-filter[aria-pressed="true"] {
        color: var(--accent);
      }
      .tag-filter[aria-pressed="true"] {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 0.2em;
      }
      .tag-filter:not(:disabled):active {
        transform: scale(0.94);
      }
      @keyframes surface-reveal {
        from {
          opacity: 0;
          transform: translateY(calc(var(--baseline) * -1));
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes post-reveal {
        from {
          opacity: 0;
          transform: translateY(calc(var(--baseline) * 1.25));
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes feedback-reveal {
        from {
          opacity: 0;
          transform: translateY(calc(var(--baseline) * 0.5));
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @media (min-width: 361px) and (max-width: 767px) {
        .search-trigger--jelly {
          transform: translateX(calc(var(--baseline) * -4));
        }
      }
      @media (max-width: 360px) {
        .header-row {
          position: relative;
        }
        .header-actions {
          width: 100%;
        }
        .search-trigger {
          position: absolute;
          top: 0;
          right: 0;
        }
        .search-trigger--jelly {
          right: calc(var(--baseline) * 3);
        }
      }
    </style>
  </body>
</html>
