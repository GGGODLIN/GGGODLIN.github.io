---
import "../styles/global.css";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import Nav from "../components/Nav.astro";
import Analytics from "../components/Analytics.astro";
import { canonicalTagRegistry } from "../data/tag-registry";
import type { ArticleSeriesContext } from "../data/series-catalog";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  seriesList?: readonly ArticleSeriesContext[];
}

const { title, description, pubDate, tags, seriesList = [] } = Astro.props;
const tagLabels = tags.map((tag) => canonicalTagRegistry.getLabel(tag));
const formattedDate = `${pubDate.getFullYear()}年${pubDate.getMonth() + 1}月${pubDate.getDate()}日`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rssURL = new URL("rss.xml", Astro.site);
const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  inLanguage: "zh-Hant",
  url: canonicalURL.toString(),
  mainEntityOfPage: canonicalURL.toString(),
  author: {
    "@type": "Person",
    name: "Philip Lin",
    alternateName: "GGGODLIN",
    url: "https://gggodlin.com",
  },
  publisher: {
    "@type": "Organization",
    name: "GGGODLIN Labs",
    url: "https://gggodlin.com",
  },
  ...(tagLabels.length > 0 ? { keywords: tagLabels } : {}),
};
const serializedJsonLd = JSON.stringify(blogPostingJsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="zh-Hant" data-theme="anthropic-warm" data-mode="light" data-user-mode="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — gggodlin</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="gggodlin" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="gggodlin" href={rssURL} />
    <script is:inline type="application/ld+json" set:html={serializedJsonLd} />
    <ThemeBoot />
  </head>
  <body>
    <header class="site-bar">
      <div class="site-bar-inner">
        <a class="brand" href="/">GGGODLIN</a>
        <Nav />
      </div>
    </header>
    <main>
      <article class="container article-body">
      <header>
        <p class="post-meta">
          {formattedDate}
          {tags.length > 0 && (
            <>
              <span aria-hidden="true"> · </span>
              {tags.map((tag, index) => (
                <>
                  {index > 0 && <span aria-hidden="true"> / </span>}
                  <a
                    class="meta-tag-link"
                    href={`/?tag=${encodeURIComponent(tag)}`}
                  >
                    {canonicalTagRegistry.getLabel(tag)}
                  </a>
                </>
              ))}
            </>
          )}
        </p>
      </header>
      <slot />
      <footer class="post-footer">
        {
          seriesList.length > 0 && (
            <nav
              class="series-nav"
              aria-label="同系列文章導讀"
              data-series-nav
            >
              {seriesList.map((series, index) => (
                <details class="series-card" open={index === 0}>
                  <summary class="series-summary">
                    <span class="series-eyebrow">
                      系列脈絡 · 第 {series.currentIndex + 1} /{" "}
                      {series.items.length} 篇
                    </span>
                    <span class="series-title">{series.title}</span>
                  </summary>
                  <div class="series-body">
                    <p class="series-concept">{series.minimumCommonConcept}</p>
                    <ol class="series-list">
                      {series.items.map((item) => (
                        <li
                          class:list={[
                            "series-item",
                            item.current && "series-item--current",
                          ]}
                        >
                          {item.current ? (
                            <>
                              <span aria-current="page">{item.title}</span>
                              <span class="series-current-badge">本篇</span>
                            </>
                          ) : (
                            <a href={`/blog/${item.slug}/`}>{item.title}</a>
                          )}
                        </li>
                      ))}
                    </ol>
                  </div>
                </details>
              ))}
            </nav>
          )
        }
        <a class="back-home-link" href="/">← 回首頁</a>
      </footer>
      </article>
    </main>
    <ThemeSwitcher />
    <Analytics />
    <script>
      import {
        extractCodeBlockText,
        formatCopyButtonState,
        type CopyButtonPhase,
      } from "../data/code-copy";

      const blocks = document.querySelectorAll<HTMLPreElement>(
        ".article-body pre",
      );
      for (const pre of blocks) {
        if (!navigator.clipboard || pre.parentElement?.classList.contains("code-block-frame")) {
          continue;
        }
        const frame = document.createElement("div");
        frame.className = "code-block-frame";
        pre.parentNode?.insertBefore(frame, pre);
        frame.appendChild(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "code-copy-btn";

        const applyPhase = (phase: CopyButtonPhase): void => {
          const view = formatCopyButtonState(phase);
          button.textContent = view.text;
          button.setAttribute("aria-label", view.ariaLabel);
          button.dataset.copied = view.copied;
        };
        applyPhase("idle");

        let resetTimer: number | undefined;
        button.addEventListener("click", async () => {
          const codeEl = pre.querySelector("code") ?? pre;
          const text = extractCodeBlockText(codeEl.textContent ?? "");
          if (text === "") return;

          if (resetTimer !== undefined) {
            window.clearTimeout(resetTimer);
          }

          try {
            await navigator.clipboard.writeText(text);
            applyPhase("copied");
          } catch {
            applyPhase("failed");
          }

          resetTimer = window.setTimeout(() => {
            applyPhase("idle");
            resetTimer = undefined;
          }, 1800);
        });

        frame.appendChild(button);
      }
    </script>
    <style>
      .site-bar {
        border-bottom: 1px solid var(--border);
        animation: site-bar-reveal 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      }
      .site-bar-inner {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: calc(var(--baseline) * 2) calc(var(--baseline) * 3);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: calc(var(--baseline) * 2);
        flex-wrap: wrap;
      }
      .brand {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: 0.05em;
        color: var(--text-secondary);
        border: none;
        transition: color 150ms ease, transform 150ms ease;
      }
      .brand:hover {
        color: var(--accent);
        border: none;
        transform: translateX(calc(var(--baseline) * 0.25));
      }
      .brand:active {
        transform: scale(0.98);
      }
      .article-body {
        padding-top: calc(var(--baseline) * 5);
        animation: article-reveal 560ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .article-body > :global(:where(p, ul, ol, blockquote) a) {
        border-bottom: none;
        text-decoration: underline;
        text-decoration-color: var(--border);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.22em;
        transition: text-decoration-color 150ms ease;
      }
      .article-body > :global(:where(p, ul, ol, blockquote) a:hover) {
        text-decoration-color: var(--accent);
      }
      .article-body :global(.code-block-frame) {
        position: relative;
        margin-bottom: calc(var(--baseline) * 3);
      }
      .article-body :global(.code-block-frame pre) {
        margin-bottom: 0;
        padding-right: calc(var(--baseline) * 8);
      }
      .article-body :global(.code-copy-btn) {
        position: absolute;
        top: calc(var(--baseline) * 1);
        right: calc(var(--baseline) * 1);
        padding: calc(var(--baseline) * 0.25) calc(var(--baseline) * 1);
        background: var(--bg-primary);
        color: var(--text-secondary);
        border: 1px solid var(--border);
        border-radius: 4px;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: 1.4;
        cursor: pointer;
        transition:
          color 140ms ease,
          border-color 140ms ease,
          transform 120ms ease;
      }
      .article-body :global(.code-copy-btn:hover),
      .article-body :global(.code-copy-btn[data-copied="true"]) {
        color: var(--accent);
        border-color: var(--accent);
      }
      .article-body :global(.code-copy-btn:focus-visible) {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .article-body :global(.code-copy-btn:active) {
        transform: scale(0.96);
      }
      .post-meta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: calc(var(--baseline) * 4);
      }
      .meta-tag-link {
        color: var(--text-secondary);
        border: none;
        transition: color 140ms ease;
      }
      .meta-tag-link:hover {
        color: var(--accent);
        border: none;
      }
      .meta-tag-link:focus-visible {
        outline: 2px solid var(--text-primary);
        outline-offset: 2px;
      }
      .series-nav {
        margin-bottom: calc(var(--baseline) * 4);
        display: flex;
        flex-direction: column;
        gap: calc(var(--baseline) * 2);
      }
      .series-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: calc(var(--baseline) * 2) calc(var(--baseline) * 2.5);
      }
      .series-summary {
        cursor: pointer;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: calc(var(--baseline) * 0.5);
      }
      .series-summary::-webkit-details-marker {
        display: none;
      }
      .series-summary:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
        border-radius: 4px;
      }
      .series-eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-secondary);
        letter-spacing: 0.04em;
      }
      .series-title {
        font-family: var(--font-display);
        font-size: var(--text-lg);
        line-height: 1.35;
        color: var(--text-primary);
        transition: color 150ms ease;
      }
      .series-summary:hover .series-title {
        color: var(--accent);
      }
      .series-body {
        margin-top: calc(var(--baseline) * 2);
        padding-top: calc(var(--baseline) * 2);
        border-top: 1px solid var(--border);
      }
      .series-concept {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        margin-bottom: calc(var(--baseline) * 2);
      }
      .series-list {
        margin-bottom: 0;
        padding-left: 1.4em;
        font-size: var(--text-sm);
      }
      .series-item {
        margin-bottom: calc(var(--baseline) * 1);
      }
      .series-item:last-child {
        margin-bottom: 0;
      }
      .series-item--current {
        color: var(--text-primary);
        font-weight: 500;
      }
      .series-current-badge {
        display: inline-block;
        margin-left: calc(var(--baseline) * 1);
        padding: 0 calc(var(--baseline) * 0.75);
        border: 1px solid var(--border);
        border-radius: 4px;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 400;
        color: var(--text-secondary);
      }
      .post-footer {
        margin-top: var(--section-gap);
        padding-top: calc(var(--baseline) * 4);
        border-top: 1px solid var(--border);
      }
      .back-home-link {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        border: none;
        transition: transform 150ms ease;
      }
      .back-home-link:hover {
        border: none;
        transform: translateX(calc(var(--baseline) * -0.5));
      }
      .back-home-link:active {
        transform: translateX(calc(var(--baseline) * -0.25)) scale(0.98);
      }
      @keyframes site-bar-reveal {
        from {
          opacity: 0;
          transform: translateY(calc(var(--baseline) * -1));
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes article-reveal {
        from {
          opacity: 0;
          transform: translateY(calc(var(--baseline) * 1.5));
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @media (max-width: 640px) {
        .site-bar-inner {
          padding: calc(var(--baseline) * 2) calc(var(--baseline) * 2.5);
        }
      }
    </style>
  </body>
</html>
