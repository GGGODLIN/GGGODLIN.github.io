---
import "../styles/global.css";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { title, description, pubDate, tags } = Astro.props;
const formattedDate = `${pubDate.getFullYear()}年${pubDate.getMonth() + 1}月${pubDate.getDate()}日`;
---

<!doctype html>
<html lang="zh-Hant" data-theme="anthropic-warm" data-mode="light" data-user-mode="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — gggodlin</title>
    <meta name="description" content={description} />
    <ThemeBoot />
  </head>
  <body>
    <header class="site-bar">
      <div class="site-bar-inner">
        <a class="brand" href="/">GGGODLIN</a>
        <Nav />
      </div>
    </header>
    <article class="container article-body">
      <header>
        <p class="post-meta">
          {formattedDate}{tags.length > 0 ? " · " + tags.join(" / ") : ""}
        </p>
      </header>
      <slot />
      <footer class="post-footer">
        <a href="/">← 回首頁</a>
      </footer>
    </article>
    <ThemeSwitcher />
    <style>
      .site-bar {
        border-bottom: 1px solid var(--border);
      }
      .site-bar-inner {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: calc(var(--baseline) * 2) calc(var(--baseline) * 3);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: calc(var(--baseline) * 2);
        flex-wrap: wrap;
      }
      .brand {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: 0.05em;
        color: var(--text-secondary);
        border: none;
      }
      .brand:hover {
        color: var(--accent);
        border: none;
      }
      .article-body {
        padding-top: calc(var(--baseline) * 5);
      }
      .post-meta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: calc(var(--baseline) * 4);
      }
      .post-footer {
        margin-top: var(--section-gap);
        padding-top: calc(var(--baseline) * 3);
        border-top: 1px solid var(--border);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
      }
      @media (max-width: 640px) {
        .site-bar-inner {
          padding: calc(var(--baseline) * 2) calc(var(--baseline) * 2.5);
        }
      }
    </style>
  </body>
</html>
