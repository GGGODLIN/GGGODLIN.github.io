---
import "../styles/global.css";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import Nav from "../components/Nav.astro";
import Analytics from "../components/Analytics.astro";
import { canonicalTagRegistry } from "../data/tag-registry";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { title, description, pubDate, tags } = Astro.props;
const tagLabels = tags.map((tag) => canonicalTagRegistry.getLabel(tag));
const formattedDate = `${pubDate.getFullYear()}年${pubDate.getMonth() + 1}月${pubDate.getDate()}日`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rssURL = new URL("rss.xml", Astro.site);
---

<!doctype html>
<html lang="zh-Hant" data-theme="anthropic-warm" data-mode="light" data-user-mode="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — gggodlin</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="gggodlin" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="gggodlin" href={rssURL} />
    <ThemeBoot />
  </head>
  <body>
    <header class="site-bar">
      <div class="site-bar-inner">
        <a class="brand" href="/">GGGODLIN</a>
        <Nav />
      </div>
    </header>
    <article class="container article-body">
      <header>
        <p class="post-meta">
          {formattedDate}{tagLabels.length > 0 ? " · " + tagLabels.join(" / ") : ""}
        </p>
      </header>
      <slot />
      <footer class="post-footer">
        <a href="/">← 回首頁</a>
      </footer>
    </article>
    <ThemeSwitcher />
    <Analytics />
    <style>
      .site-bar {
        border-bottom: 1px solid var(--border);
        animation: site-bar-reveal 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      }
      .site-bar-inner {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: calc(var(--baseline) * 2) calc(var(--baseline) * 3);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: calc(var(--baseline) * 2);
        flex-wrap: wrap;
      }
      .brand {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        letter-spacing: 0.05em;
        color: var(--text-secondary);
        border: none;
        transition: color 150ms ease, transform 150ms ease;
      }
      .brand:hover {
        color: var(--accent);
        border: none;
        transform: translateX(calc(var(--baseline) * 0.25));
      }
      .brand:active {
        transform: scale(0.98);
      }
      .article-body {
        padding-top: calc(var(--baseline) * 5);
        animation: article-reveal 560ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .post-meta {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: calc(var(--baseline) * 4);
      }
      .post-footer {
        margin-top: var(--section-gap);
        padding-top: calc(var(--baseline) * 3);
        border-top: 1px solid var(--border);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
      }
      .post-footer a {
        display: inline-block;
        border: none;
        transition: transform 150ms ease;
      }
      .post-footer a:hover {
        border: none;
        transform: translateX(calc(var(--baseline) * -0.5));
      }
      .post-footer a:active {
        transform: translateX(calc(var(--baseline) * -0.25)) scale(0.98);
      }
      @keyframes site-bar-reveal {
        from {
          opacity: 0;
          transform: translateY(calc(var(--baseline) * -1));
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes article-reveal {
        from {
          opacity: 0;
          transform: translateY(calc(var(--baseline) * 1.5));
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @media (max-width: 640px) {
        .site-bar-inner {
          padding: calc(var(--baseline) * 2) calc(var(--baseline) * 2.5);
        }
      }
    </style>
  </body>
</html>
